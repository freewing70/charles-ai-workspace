---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  badge?: string;
}

const { eyebrow, title, description, badge } = Astro.props;
---

<div class="mb-10">
  <div class="flex items-center gap-2 mb-2">
    {eyebrow && (
      <span class="text-xs font-mono font-bold tracking-[0.25em] text-[#155EEF] uppercase">
        {eyebrow}
      </span>
    )}
    {badge && (
      <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
        {badge}
      </span>
    )}
  </div>
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#07172D]">
    {title}
  </h1>
  {description && (
    <p class="mt-2 text-slate-600 max-w-3xl text-base leading-relaxed">
      {description}
    </p>
  )}
</div>
