---
import type { ContentMetadata } from '../lib/schema';
import { getAssetUrl, getContentRoute } from '../lib/assets';

interface Props {
  item: ContentMetadata;
}

const { item } = Astro.props;
const route = getContentRoute(item.type, item.id);
const coverUrl = getAssetUrl(item.cover);

const typeColors: Record<string, string> = {
  skill: "bg-indigo-500/10 text-indigo-400 border-indigo-500/30",
  tutorial: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30",
  presentation: "bg-amber-500/10 text-amber-400 border-amber-500/30",
  project: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30",
  note: "bg-purple-500/10 text-purple-400 border-purple-500/30",
};

const badgeClass = typeColors[item.type] || "bg-gray-500/10 text-gray-400 border-gray-500/30";
---

<div class="group relative flex flex-col bg-[#111827] rounded-xl border border-gray-800/80 hover:border-indigo-500/50 transition-all duration-300 overflow-hidden hover:shadow-xl hover:shadow-indigo-500/5">
  <!-- Thumbnail -->
  <div class="aspect-video w-full overflow-hidden bg-gray-900 relative">
    <img
      src={coverUrl}
      alt={item.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute top-3 left-3 flex items-center gap-2">
      <span class={`text-[11px] font-semibold uppercase px-2.5 py-0.5 rounded-full border backdrop-blur-md ${badgeClass}`}>
        {item.type}
      </span>
      {item.featured && (
        <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-300 border border-yellow-500/30 backdrop-blur-md flex items-center gap-1">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Featured
        </span>
      )}
    </div>
    <div class="absolute bottom-2 right-2 text-[10px] font-mono px-2 py-0.5 rounded bg-black/60 text-gray-300 backdrop-blur-sm">
      v{item.version}
    </div>
  </div>

  <!-- Details -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-gray-400 mb-2 font-mono">
        <span>{item.category}</span>
        <time datetime={item.updated}>{item.updated}</time>
      </div>
      <h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors line-clamp-1">
        <a href={route}>
          <span class="absolute inset-0"></span>
          {item.title}
        </a>
      </h3>
      <p class="mt-2 text-sm text-gray-400 line-clamp-2 leading-relaxed">
        {item.summary}
      </p>
    </div>

    <!-- Tags & Tools Footer -->
    <div class="mt-4 pt-3 border-t border-gray-800/60 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {item.tags.slice(0, 3).map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded bg-gray-800/80 text-gray-300 font-mono">
            #{tag}
          </span>
        ))}
      </div>
      <span class="text-xs text-indigo-400 font-medium group-hover:translate-x-0.5 transition-transform flex items-center">
        檢視 &rarr;
      </span>
    </div>
  </div>
</div>
