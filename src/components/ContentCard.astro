---
import type { ContentMetadata } from '../lib/schema';
import { getAssetUrl, getContentRoute } from '../lib/assets';

interface Props {
  item: ContentMetadata;
}

const { item } = Astro.props;
const route = getContentRoute(item.type, item.id);
const coverUrl = getAssetUrl(item.cover);

const typeBadgeStyles: Record<string, { label: string; class: string; eyebrow: string }> = {
  skill: { label: "Skill", class: "bg-blue-50/95 text-[#155EEF] border-blue-200/90", eyebrow: "LEARN" },
  tutorial: { label: "Tutorial", class: "bg-sky-50/95 text-[#0369A1] border-sky-200/90", eyebrow: "EXPLORE" },
  presentation: { label: "Presentation", class: "bg-amber-50/95 text-[#B45309] border-amber-200/90", eyebrow: "SHARE" },
  project: { label: "Project", class: "bg-indigo-50/95 text-[#4338CA] border-indigo-200/90", eyebrow: "CREATE" },
  note: { label: "Note", class: "bg-slate-100/95 text-[#334155] border-slate-300/90", eyebrow: "THINK" },
  newspaper: { label: "Newspaper", class: "bg-rose-50/95 text-[#BE123C] border-rose-200/90", eyebrow: "DAILY" },
};

const badge = typeBadgeStyles[item.type] || { label: item.type, class: "bg-gray-50/95 text-gray-600 border-gray-200", eyebrow: "ASSET" };
---

<div class="freewing-card group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-xs hover:shadow-xl hover:border-[#155EEF]/40 transition-all duration-300">
  <!-- Top Visual Container -->
  <div class="aspect-video w-full overflow-hidden bg-slate-100 relative border-b border-slate-100">
    <img
      src={coverUrl}
      alt={item.title}
      width="640"
      height="360"
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
    />
    <!-- Gradient Scrim for Contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
    
    <div class="absolute top-3 left-3 flex items-center gap-2 z-10">
      <span class={`text-[11px] font-mono font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-full border shadow-xs backdrop-blur-md ${badge.class}`}>
        {badge.eyebrow} &bull; {badge.label}
      </span>
      {item.featured && (
        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-50/95 text-amber-800 border border-amber-300/90 shadow-xs flex items-center gap-1 backdrop-blur-md">
          <svg class="w-3 h-3 fill-amber-500" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Featured
        </span>
      )}
    </div>
    <div class="absolute bottom-2.5 right-2.5 text-[10px] font-mono font-semibold px-2 py-0.5 rounded-md bg-white/95 text-slate-700 border border-slate-200/90 shadow-2xs backdrop-blur-md z-10">
      v{item.version}
    </div>
  </div>

  <!-- Content Details -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-slate-500 mb-2 font-mono">
        <span class="font-semibold text-slate-700">{item.category}</span>
        <time datetime={item.updated} class="font-semibold text-slate-600">{item.updated}</time>
      </div>
      <h3 class="text-base font-extrabold text-[#0B1B32] group-hover:text-[#155EEF] transition-colors line-clamp-1">
        <a href={route}>
          <span class="absolute inset-0"></span>
          {item.title}
        </a>
      </h3>
      <p class="mt-2.5 text-sm text-slate-600 line-clamp-2 leading-relaxed">
        {item.summary}
      </p>
    </div>

    <!-- Tags & Arrow Footer -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {item.tags.slice(0, 3).map((tag) => (
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-50 text-slate-600 border border-slate-200/80 font-mono font-medium">
            #{tag}
          </span>
        ))}
      </div>
      <span class="text-xs font-bold text-[#155EEF] group-hover:translate-x-1.5 transition-transform flex items-center gap-1">
        <span>檢視</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span>
    </div>
  </div>
</div>
