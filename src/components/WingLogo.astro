      <stop offset="0%" stop-color="#07172D"/>
      <stop offset="40%" stop-color="#155EEF"/>
      <stop offset="100%" stop-color="#27A8FF"/>
    </linearGradient>

    <!-- Right Wing Gradient (Sunlit Warm Edge) -->
