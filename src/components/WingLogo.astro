      <stop offset="0%" stop-color="#27A8FF"/>
      <stop offset="50%" stop-color="#155EEF"/>
      <stop offset="100%" stop-color="#07172D"/>
    </linearGradient>
    <linearGradient id="rightInner" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#70C8FF"/>
      <stop offset="45%" stop-color="#E8B85C"/>
      <stop offset="100%" stop-color="#D99B26"/>
    </linearGradient>
