<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 100" fill="none" class="w-full h-full">
  <defs>
    <!-- Left Wing Gradient -->
    <linearGradient id="leftOuter" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#155EEF"/>
      <stop offset="60%" stop-color="#27A8FF"/>
      <stop offset="100%" stop-color="#70C8FF"/>
    </linearGradient>
    <linearGradient id="leftInner" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#70C8FF"/>
      <stop offset="50%" stop-color="#27A8FF"/>
      <stop offset="100%" stop-color="#E8B85C"/>
