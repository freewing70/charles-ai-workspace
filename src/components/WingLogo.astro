  <!-- Left Outer Wing Feather -->
  <path d="M 8 16 C 26 22, 48 50, 68 84 C 52 80, 26 56, 8 16 Z" fill="url(#leftOuter)" />

  <!-- Left Inner Wing Feather (Layered) -->
