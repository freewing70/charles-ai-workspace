---
interface Props {
  class?: string;
  variant?: 'color' | 'dark' | 'mono';
}

const {
  class: className = "w-full h-full",
  variant = 'color'
} = Astro.props;

const srcMap = {
  color: '/brand/freewing-symbol.svg',
  dark: '/brand/freewing-symbol-dark.svg',
  mono: '/brand/freewing-symbol-mono.svg'
};

const src = srcMap[variant] || srcMap.color;
---

<img
  src={src}
  alt="FreewingBiz Wing-W Symbol"
  class={`object-contain ${className}`}
  loading="eager"
  decoding="async"
/>
