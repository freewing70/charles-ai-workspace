---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getItemsByType } from '../../lib/content';

const newspapers = getItemsByType('newspaper', false);
const featuredNewspaper = newspapers.find((n) => n.meta.featured) || newspapers[0];
---

<MainLayout 
  title="AI 模型日報 (Daily AI Newspaper) | FreewingBiz" 
  description="Chow 的 AI 模型日報 — 每日 5 則全球 AI 科技頭條、大模型實測、影音導讀與深度分析。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#07172D] via-[#111827] to-[#881337] p-8 sm:p-12 text-white shadow-2xl">
      <div class="absolute -right-12 -bottom-12 w-80 h-80 bg-rose-500/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-rose-500/20 border border-rose-400/30 text-rose-300 text-xs font-mono font-bold tracking-wider uppercase">
          <span>DAILY HEADLINES & YOUTUBE VIDEO</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
          Chow 的 <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-rose-200">AI 模型日報</span>
        </h1>
        
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed">
          每日精選 5 則全球 AI 關鍵頭條、大模型評測、白宮/國際監管趨勢與前沿論文，搭配 YouTube 影音專業導讀與復古雙欄報紙閱讀體驗。
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a 
            href={featuredNewspaper ? `/newspapers/${featuredNewspaper.meta.id}` : '#'} 
            class="px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm transition-all shadow-lg hover:shadow-rose-600/30 flex items-center gap-2"
          >
            <span>閱讀最新日報 (第 004 號)</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a 
            href="https://www.youtube.com/@Chow%E7%9A%84AI%E6%A8%A1%E5%9E%8B%E6%97%A5%E5%A0%B1/playlists" 
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm transition-all flex items-center gap-2"
          >
            <svg class="w-5 h-5 text-rose-500 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>@Chow的AI模型日報 頻道</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Newspaper Issues Grid -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-mono font-bold tracking-[0.28em] text-rose-600 uppercase">ARCHIVE</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#07172D] mt-1">歷期 AI 模型日報</h2>
        </div>
        <span class="text-xs font-mono text-slate-500">共 {newspapers.length} 期發布</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {newspapers.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    </section>
  </div>
</MainLayout>
