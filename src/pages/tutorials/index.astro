---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getItemsByType } from '../../lib/content';

const tutorials = getItemsByType('tutorial', false);
---

<MainLayout title="Tutorials 實戰教學">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="EXPLORE"
      title="Tutorials 實戰教學"
      description="系統性的 AI 操作、提示詞工程與自動化開發指南，包含實戰步驟與整合簡報入口。"
      badge={`${tutorials.length} 篇教學`}
    />

    {tutorials.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tutorials.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border border-slate-200">
        <p class="text-slate-500">目前尚無公開教學，即將推出。</p>
      </div>
    )}
  </div>
</MainLayout>
