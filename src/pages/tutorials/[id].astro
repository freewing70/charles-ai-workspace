---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllItems, getItemById } from '../../lib/content';
import { marked } from 'marked';

export function getStaticPaths() {
  const items = getAllItems(false).filter(i => i.meta.type === 'tutorial');
  return items.map((item) => ({
    params: { id: item.meta.id },
  }));
}

const { id } = Astro.params;
const item = getItemById(id, false);

if (!item) {
  return Astro.redirect('/404');
}

const htmlContent = marked.parse(item.content);
---

<MainLayout title={item.meta.title} description={item.meta.summary}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-8">
      <a href="/" class="hover:text-[#155EEF] transition-colors">首頁</a>
      <span>/</span>
      <a href="/tutorials" class="hover:text-[#155EEF] transition-colors">Tutorials</a>
      <span>/</span>
      <span class="text-[#07172D] font-bold">{item.meta.id}</span>
    </nav>

    <div class="freewing-card p-6 sm:p-10 mb-10 border border-slate-200">
      <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-3">
        <span class="px-2.5 py-1 rounded-full bg-sky-50 text-[#0284C7] border border-sky-200 font-semibold">
          {item.meta.category}
        </span>
        <time datetime={item.meta.updated}>{item.meta.updated}</time>
      </div>
      <h1 class="text-3xl font-extrabold text-[#07172D] tracking-tight mb-4">{item.meta.title}</h1>
      <p class="text-slate-600 leading-relaxed">{item.meta.summary}</p>
    </div>

    <article class="freewing-card p-6 sm:p-12 shadow-sm prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-[#07172D]">
      <div set:html={htmlContent} />
    </article>
  </div>
</MainLayout>
