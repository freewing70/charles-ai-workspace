---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ContentCard from '../components/ContentCard.astro';
import { getAllItems } from '../lib/content';

// Load public items
const allItems = getAllItems(false);
const featuredItems = allItems.filter((i) => i.meta.featured);
const recentItems = allItems.slice(0, 6);

const categories = [
  { name: "Skills", eyebrow: "LEARN", count: allItems.filter(i => i.meta.type === 'skill').length, href: "/skills", desc: "提示詞模組、系統規範與工作流技能封裝" },
  { name: "Tutorials", eyebrow: "EXPLORE", count: allItems.filter(i => i.meta.type === 'tutorial').length, href: "/tutorials", desc: "漸進式操作課程、核心原理與指引文件" },
  { name: "Presentations", eyebrow: "SHARE", count: allItems.filter(i => i.meta.type === 'presentation').length, href: "/presentations", desc: "HTML5 原生簡報、在線演練與全螢幕播放" },
  { name: "Projects", eyebrow: "CREATE", count: allItems.filter(i => i.meta.type === 'project').length, href: "/projects", desc: "專案成果展示、工具鏈架構與實際產出" },
  { name: "Notes", eyebrow: "THINK", count: allItems.filter(i => i.meta.type === 'note').length, href: "/notes", desc: "模型實測評鑑、Prompt 實驗與前沿觀察" },
  { name: "Timeline", eyebrow: "JOURNEY", count: allItems.length, href: "/timeline", desc: "完整工作資產之建立與演進歷史足跡" },
];
---

<MainLayout title="FreewingBiz | Charles AI Workspace" isTransparentNav={true}>
  <!-- Atmospheric Master Hero Section -->
  <Hero />

  <!-- Main Body Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    
    <!-- Quick Category Exploration Grid -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-mono font-bold tracking-[0.25em] text-[#155EEF] uppercase">TAXONOMY</span>
          <h2 class="text-2xl font-bold tracking-tight text-[#07172D] mt-1">六大知識資產單元</h2>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="freewing-card group p-6 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-mono font-semibold tracking-wider text-[#155EEF] uppercase px-2 py-0.5 rounded bg-blue-50 border border-blue-200/60">
                  {cat.eyebrow}
                </span>
                <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200/80">
                  {cat.count} 項目
                </span>
              </div>
              <h3 class="text-lg font-bold text-[#07172D] group-hover:text-[#155EEF] transition-colors">
                {cat.name}
              </h3>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                {cat.desc}
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-slate-100 text-xs font-semibold text-[#155EEF] group-hover:translate-x-1 transition-transform flex items-center gap-1">
              進入單元 &rarr;
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Highlights Section -->
    {featuredItems.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-mono font-bold tracking-[0.25em] text-[#E8B85C] uppercase">HIGHLIGHTS</span>
            <h2 class="text-2xl font-bold tracking-tight text-[#07172D] mt-1">精選內容與代表作</h2>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredItems.map((item) => (
            <ContentCard item={item.meta} />
          ))}
        </div>
      </section>
    )}

    <!-- Recent Updates Section -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-mono font-bold tracking-[0.25em] text-[#27A8FF] uppercase">RECENT ACTIVITY</span>
          <h2 class="text-2xl font-bold tracking-tight text-[#07172D] mt-1">最近發布與更新</h2>
        </div>
        <a href="/timeline" class="text-sm font-semibold text-[#155EEF] hover:text-[#0D47C2] flex items-center gap-1 transition-colors">
          查看完整時間軸 &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentItems.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    </section>
  </div>
</MainLayout>
