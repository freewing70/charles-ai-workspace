---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ContentCard from '../components/ContentCard.astro';
import { getAllItems } from '../lib/content';

// Load public items
const allItems = getAllItems(false);
const featuredItems = allItems.filter((i) => i.meta.featured);
const recentItems = allItems.slice(0, 6);
---

<MainLayout title="FreewingBiz | Charles AI Workspace" isTransparentNav={true}>
  <!-- Atmospheric Master Hero Section -->
  <Hero />

  <!-- Main Body Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-16 sm:space-y-20">
    
    <!-- FLAGSHIP HERO BANNER: AI Cinematography Simulator -->
    <section aria-label="旗艦特色工具推薦" class="relative group">
      <!-- Glow ambient backdrop -->
      <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 opacity-20 blur-xl group-hover:opacity-35 transition duration-500 pointer-events-none"></div>

      <a
        href="/skills/camera-controls/"
        class="relative block overflow-hidden rounded-3xl border border-slate-700/80 bg-gradient-to-br from-slate-950 via-[#07172D] to-slate-900 p-8 sm:p-12 text-white shadow-2xl transition-all duration-300 hover:border-blue-500/50 hover:shadow-blue-500/10"
      >
        <!-- Background Decorative Cinema Wireframe & Grid -->
        <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
          <!-- Left: Title, Badges & Copy -->
          <div class="max-w-2xl space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider bg-gradient-to-r from-blue-500/30 to-cyan-500/30 text-cyan-300 border border-cyan-400/30">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                FLAGSHIP TOOL · 旗艦互動工具
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30">
                40 款好萊塢標準運鏡
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                雙視角 3D 即時模擬
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                7 大視頻模型支援
              </span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight">
              AI 電影運鏡工程模擬器
            </h2>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              不要盲目抽卡消耗算力！專為短劇與 AI 影視創作者打造，以真實攝影物理坐標即時預覽 40 款標準運鏡語言，並一鍵編譯輸出 <span class="text-white font-semibold">可靈 Kling · Runway · Luma · Sora · Wan · Seedance · MiniMax H3</span> 影視級提示詞。
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <div class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-[#155EEF] to-[#27A8FF] text-white text-sm font-bold shadow-lg shadow-blue-500/25 group-hover:from-[#0D47C2] group-hover:to-[#155EEF] group-hover:scale-102 transition-all duration-300">
                <span>立即啟動 3D 空間透視模擬</span>
                <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>
              <span class="text-xs font-mono text-slate-400">
                零依賴純前端 3D 渲染 · 毫秒級流暢預覽
              </span>
            </div>
          </div>

          <!-- Right: Visual Feature Badges / Showcase Card -->
          <div class="lg:w-80 shrink-0 bg-slate-900/80 rounded-2xl border border-slate-700/80 p-5 space-y-3.5 backdrop-blur-sm">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 pb-2 border-b border-slate-800">
              <span class="text-cyan-400 font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                DUAL 3D VIEWPORT
              </span>
              <span>4K DCI · 60 FPS</span>
            </div>

            <!-- Visual Pills Grid -->
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/60 border border-slate-700/50">
                <span class="text-slate-300 font-medium">觀景窗視角 (Viewfinder)</span>
                <span class="text-emerald-400 font-mono font-bold">即時光學渲染</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/60 border border-slate-700/50">
                <span class="text-slate-300 font-medium">三維空間機位 (God's Eye)</span>
                <span class="text-cyan-400 font-mono font-bold">3D 坐標聯動</span>
              </div>
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/60 border border-slate-700/50">
                <span class="text-slate-300 font-medium">專用提示詞編譯器</span>
                <span class="text-amber-400 font-mono font-bold">7 大模型一鍵複製</span>
              </div>
            </div>

            <div class="pt-2 text-[11px] font-mono text-slate-400 text-center font-medium group-hover:text-cyan-300 transition-colors">
              點擊橫幅直達工具頁面 ➔
            </div>
          </div>
        </div>
      </a>
    </section>

    <!-- Featured Highlights Section -->
    {featuredItems.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-mono font-bold tracking-[0.28em] text-[#E8B85C] uppercase">HIGHLIGHTS</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#07172D] mt-1">精選內容與代表作</h2>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredItems.map((item) => (
            <ContentCard item={item.meta} />
          ))}
        </div>
      </section>
    )}

    <!-- Recent Updates Section -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-mono font-bold tracking-[0.28em] text-[#27A8FF] uppercase">RECENT ACTIVITY</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#07172D] mt-1">最近發布與更新</h2>
        </div>
        <a href="/timeline" class="text-sm font-bold text-[#155EEF] hover:text-[#0D47C2] flex items-center gap-1.5 transition-colors group">
          <span>查看時間軸</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentItems.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    </section>
  </div>
</MainLayout>
