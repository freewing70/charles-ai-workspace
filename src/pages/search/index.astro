---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<MainLayout title="全站檢索中心">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="SEARCH"
      title="全站檢索中心"
      description="即時檢索標題、摘要、標籤、工具與分類。支援即時篩選與跳轉。"
    />

    <!-- Search Input Area -->
    <div class="freewing-card p-4 sm:p-6 mb-8 border border-slate-200">
      <div class="relative flex items-center">
        <div class="absolute left-4 text-slate-400 pointer-events-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="輸入關鍵字（例如：watercolor, rpg, prompt, 算力, youtube, gguf）..."
          class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-12 pr-10 py-3.5 text-[#07172D] placeholder-slate-400 focus:outline-none focus:border-[#155EEF] focus:bg-white focus:ring-3 focus:ring-[#155EEF]/10 text-base transition-all font-medium"
          autofocus
        />
        <button
          id="clear-btn"
          class="absolute right-3 text-slate-400 hover:text-slate-600 hidden p-1 text-sm font-mono cursor-pointer"
        >
          &times;
        </button>
      </div>

      <!-- Filter Controls -->
      <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2" id="type-filters">
          <span class="text-slate-500 font-mono font-semibold">類型:</span>
          <button data-type="all" class="type-filter-btn px-3 py-1 rounded-lg bg-[#155EEF] text-white font-semibold shadow-2xs">全部</button>
          <button data-type="skill" class="type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium">Skill</button>
          <button data-type="tutorial" class="type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium">Tutorial</button>
          <button data-type="presentation" class="type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium">Presentation</button>
          <button data-type="project" class="type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium">Project</button>
          <button data-type="note" class="type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium">Note</button>
        </div>
        <div id="result-count" class="text-slate-500 font-mono text-xs">
          載入索引中...
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div id="results-container" class="space-y-4">
      <!-- Injected via Client Script -->
    </div>
  </div>

  <!-- Client-side Search Logic using Fuse.js -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
  <script is:inline>
    let searchData = [];
    let fuseInstance = null;
    let currentTypeFilter = 'all';

    const input = document.getElementById('search-input');
    const clearBtn = document.getElementById('clear-btn');
    const container = document.getElementById('results-container');
    const countEl = document.getElementById('result-count');
    const filterBtns = document.querySelectorAll('.type-filter-btn');

    async function initSearch() {
      try {
        const res = await fetch('/search-index.json');
        searchData = await res.json();
        
        fuseInstance = new Fuse(searchData, {
          keys: [
            { name: 'title', weight: 0.4 },
            { name: 'tags', weight: 0.3 },
            { name: 'summary', weight: 0.2 },
            { name: 'tools', weight: 0.1 },
            { name: 'category', weight: 0.1 }
          ],
          threshold: 0.35,
          ignoreLocation: true
        });

        const urlParams = new URLSearchParams(window.location.search);
        const query = urlParams.get('q');
        if (query) {
          input.value = query;
          performSearch();
        } else {
          renderList(searchData);
        }
      } catch (err) {
        console.error('Failed to load search index:', err);
        countEl.textContent = '搜尋索引載入失敗';
      }
    }

    function performSearch() {
      const q = input.value.trim();
      clearBtn.style.display = q ? 'block' : 'none';

      let results = searchData;
      if (q && fuseInstance) {
        const searchResults = fuseInstance.search(q);
        results = searchResults.map(r => r.item);
      }

      if (currentTypeFilter !== 'all') {
        results = results.filter(item => item.type === currentTypeFilter);
      }

      renderList(results);
    }

    function renderList(items) {
      countEl.textContent = `共 ${items.length} 筆結果`;
      if (items.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 freewing-card border border-slate-200">
            <p class="text-slate-500 font-medium">找不到符合條件的內容。</p>
          </div>
        `;
        return;
      }

      container.innerHTML = items.map(item => `
        <a href="${item.url}" class="freewing-card block p-6 border border-slate-200 hover:border-blue-300 transition-all group">
          <div class="flex items-center justify-between gap-4 mb-2">
            <div class="flex items-center gap-2">
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-blue-50 text-[#155EEF] border border-blue-200 font-semibold">
                ${item.type}
              </span>
              <span class="text-xs text-slate-500 font-mono">${item.category}</span>
            </div>
            <time class="text-xs text-slate-400 font-mono">${item.updated}</time>
          </div>
          <h3 class="text-base font-bold text-[#07172D] group-hover:text-[#155EEF] transition-colors">
            ${item.title}
          </h3>
          <p class="text-sm text-slate-600 mt-1 line-clamp-2 leading-relaxed">
            ${item.summary}
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            ${item.tags.map(t => `<span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">#${t}</span>`).join('')}
          </div>
        </a>
      `).join('');
    }

    input.addEventListener('input', performSearch);
    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.focus();
      performSearch();
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.className = 'type-filter-btn px-3 py-1 rounded-lg bg-slate-100 text-slate-600 hover:text-slate-900 font-medium';
        });
        btn.className = 'type-filter-btn px-3 py-1 rounded-lg bg-[#155EEF] text-white font-semibold shadow-2xs';
        currentTypeFilter = btn.getAttribute('data-type');
        performSearch();
      });
    });

    initSearch();
  </script>
</MainLayout>
