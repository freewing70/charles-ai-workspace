---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="全站搜尋">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-white tracking-tight mb-2">全站檢索中心</h1>
      <p class="text-gray-400 text-sm">
        即時檢索標題、摘要、標籤、工具與分類。支援即時篩選與跳轉。
      </p>
    </div>

    <!-- Search Input Area -->
    <div class="bg-[#111827] rounded-2xl border border-gray-800 p-4 mb-6 shadow-xl">
      <div class="relative flex items-center">
        <div class="absolute left-4 text-gray-400 pointer-events-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="輸入關鍵字（例如：watercolor, rpg, prompt, codex）..."
          class="w-full bg-gray-900 border border-gray-700/70 rounded-xl pl-12 pr-10 py-3.5 text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500 text-base"
          autofocus
        />
        <button
          id="clear-btn"
          class="absolute right-3 text-gray-500 hover:text-white hidden p-1 text-sm font-mono"
        >
          &times;
        </button>
      </div>

      <!-- Filter Controls -->
      <div class="mt-4 pt-3 border-t border-gray-800 flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2" id="type-filters">
          <span class="text-gray-400 font-mono">類型:</span>
          <button data-type="all" class="type-filter-btn px-2.5 py-1 rounded bg-indigo-600 text-white font-medium">全部</button>
          <button data-type="skill" class="type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white">Skill</button>
          <button data-type="tutorial" class="type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white">Tutorial</button>
          <button data-type="presentation" class="type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white">Presentation</button>
          <button data-type="project" class="type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white">Project</button>
          <button data-type="note" class="type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white">Note</button>
        </div>
        <div id="result-count" class="text-gray-400 font-mono">
          載入索引中...
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div id="results-container" class="space-y-3">
      <!-- Injected via Client Script -->
    </div>
  </div>

  <!-- Client-side Search Logic using Fuse.js -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
  <script is:inline>
    let searchData = [];
    let fuseInstance = null;
    let currentTypeFilter = 'all';

    const input = document.getElementById('search-input');
    const clearBtn = document.getElementById('clear-btn');
    const container = document.getElementById('results-container');
    const countEl = document.getElementById('result-count');
    const filterBtns = document.querySelectorAll('.type-filter-btn');

    // Fetch build-time search index
    async function initSearch() {
      try {
        const res = await fetch('/search-index.json');
        searchData = await res.json();
        
        fuseInstance = new Fuse(searchData, {
          keys: [
            { name: 'title', weight: 0.4 },
            { name: 'tags', weight: 0.3 },
            { name: 'summary', weight: 0.2 },
            { name: 'tools', weight: 0.1 },
            { name: 'category', weight: 0.1 }
          ],
          threshold: 0.35,
          ignoreLocation: true
        });

        // Check URL query param
        const urlParams = new URLSearchParams(window.location.search);
        const query = urlParams.get('q');
        if (query) {
          input.value = query;
          performSearch();
        } else {
          renderList(searchData);
        }
      } catch (err) {
        console.error('Failed to load search index:', err);
        countEl.textContent = '搜尋索引載入失敗';
      }
    }

    function performSearch() {
      const q = input.value.trim();
      clearBtn.style.display = q ? 'block' : 'none';

      let results = searchData;
      if (q && fuseInstance) {
        const searchResults = fuseInstance.search(q);
        results = searchResults.map(r => r.item);
      }

      if (currentTypeFilter !== 'all') {
        results = results.filter(item => item.type === currentTypeFilter);
      }

      renderList(results);
    }

    function renderList(items) {
      countEl.textContent = `共 ${items.length} 筆結果`;
      if (items.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 bg-[#111827] rounded-2xl border border-gray-800">
            <p class="text-gray-400">找不到符合條件的內容。</p>
          </div>
        `;
        return;
      }

      container.innerHTML = items.map(item => `
        <a href="${item.url}" class="block p-5 rounded-2xl bg-[#111827] border border-gray-800 hover:border-indigo-500/50 transition-all group">
          <div class="flex items-center justify-between gap-4 mb-2">
            <div class="flex items-center gap-2">
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-gray-800 text-indigo-400 border border-gray-700">
                ${item.type}
              </span>
              <span class="text-xs text-gray-400 font-mono">${item.category}</span>
            </div>
            <time class="text-xs text-gray-500 font-mono">${item.updated}</time>
          </div>
          <h3 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors">
            ${item.title}
          </h3>
          <p class="text-sm text-gray-400 mt-1 line-clamp-2 leading-relaxed">
            ${item.summary}
          </p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            ${item.tags.map(t => `<span class="text-[10px] px-2 py-0.5 rounded bg-gray-800 text-gray-300 font-mono">#${t}</span>`).join('')}
          </div>
        </a>
      `).join('');
    }

    // Event listeners
    input.addEventListener('input', performSearch);
    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.focus();
      performSearch();
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.className = 'type-filter-btn px-2.5 py-1 rounded bg-gray-800 text-gray-300 hover:text-white';
        });
        btn.className = 'type-filter-btn px-2.5 py-1 rounded bg-indigo-600 text-white font-medium';
        currentTypeFilter = btn.getAttribute('data-type');
        performSearch();
      });
    });

    initSearch();
  </script>
</MainLayout>
