---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllItems, getItemById } from '../../lib/content';
import { getAssetUrl, getContentRoute } from '../../lib/assets';
import { marked } from 'marked';

export function getStaticPaths() {
  const items = getAllItems(false).filter(i => i.meta.type === 'project');
  return items.map((item) => ({
    params: { id: item.meta.id },
  }));
}

const { id } = Astro.params;
const item = getItemById(id, false);

if (!item) {
  return Astro.redirect('/404');
}

const htmlContent = marked.parse(item.content);
---

<MainLayout title={item.meta.title} description={item.meta.summary}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-8">
      <a href="/" class="hover:text-[#155EEF] transition-colors">首頁</a>
      <span>/</span>
      <a href="/projects" class="hover:text-[#155EEF] transition-colors">Projects</a>
      <span>/</span>
      <span class="text-[#07172D] font-bold">{item.meta.id}</span>
    </nav>

    <!-- Header Card -->
    <div class="freewing-card p-6 sm:p-10 mb-10 border border-slate-200">
      <div class="flex items-center justify-between text-xs text-slate-500 font-mono mb-3">
        <span class="px-2.5 py-1 rounded-full bg-indigo-50 text-[#4338CA] border border-indigo-200 font-semibold">
          {item.meta.category}
        </span>
        <time datetime={item.meta.updated}>{item.meta.updated}</time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#07172D] tracking-tight mb-4">
        {item.meta.title}
      </h1>
      <p class="text-slate-600 text-base leading-relaxed mb-6">{item.meta.summary}</p>

      <div class="flex flex-wrap items-center gap-4 pt-5 border-t border-slate-100 text-xs text-slate-500">
        <div>
          <span class="font-medium text-slate-400">使用工具:</span>
          {item.meta.tools.map(t => (
            <span class="ml-1.5 px-2 py-0.5 rounded bg-blue-50 text-[#155EEF] font-mono">{t}</span>
          ))}
        </div>
        <div>
          <span class="font-medium text-slate-400">標籤:</span>
          {item.meta.tags.map(tag => (
            <span class="ml-1.5 px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">#{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Markdown Content -->
    <article class="freewing-card p-6 sm:p-12 mb-10 prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-[#07172D]">
      <div set:html={htmlContent} />
    </article>

    <!-- Cross Relations -->
    {item.meta.relatedSkills?.length && (
      <div class="freewing-card p-6 sm:p-8 bg-slate-50/70 border border-slate-200">
        <h3 class="text-base font-bold text-[#07172D] mb-4">本專案運用的 AI Skills</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {item.meta.relatedSkills.map(skillId => {
            const rel = getItemById(skillId, false);
            return rel ? (
              <a href={getContentRoute('skill', skillId)} class="p-4 rounded-xl bg-white hover:border-blue-300 border border-slate-200 text-sm flex items-center justify-between transition-all shadow-2xs">
                <div>
                  <span class="text-[#07172D] font-bold block">{rel.meta.title}</span>
                  <span class="text-xs text-slate-500 font-mono">v{rel.meta.version}</span>
                </div>
                <span class="text-xs text-[#155EEF] font-semibold font-mono">檢視模組 &rarr;</span>
              </a>
            ) : null;
          })}
        </div>
      </div>
    )}
  </div>
</MainLayout>
