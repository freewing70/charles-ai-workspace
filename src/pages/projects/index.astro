---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getItemsByType } from '../../lib/content';

const projects = getItemsByType('project', false);
---

<MainLayout title="Projects 專案成果">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="CREATE"
      title="AI 專案與實務成果"
      description="完整 AI 工具鏈架構、應用落地實作與跨領域成果，串聯相關使用的 Skill 與技術報告。"
      badge={`${projects.length} 個專案`}
    />

    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border border-slate-200">
        <p class="text-slate-500">目前尚無公開專案。</p>
      </div>
    )}
  </div>
</MainLayout>
