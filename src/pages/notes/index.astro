---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getItemsByType } from '../../lib/content';

const notes = getItemsByType('note', false);
---

<MainLayout 
  title="Notes 研究筆記 | FreewingBiz" 
  description="FreewingBiz Notes 研究筆記 — 記錄 AI 模型實測評鑑、Prompt 實驗與前沿技術觀察筆記。"
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="THINK"
      title="AI 模型與工作流筆記"
      description="記錄大型語言模型實測、Prompting 技巧、圖像生成一致性實驗與實戰思考。"
      badge={`${notes.length} 篇筆記`}
    />

    {notes.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {notes.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 px-6 bg-slate-50 rounded-3xl border border-slate-200 max-w-2xl mx-auto space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-sky-50 border border-sky-200 text-[#0369A1] mx-auto flex items-center justify-center font-bold">
          📝
        </div>
        <h3 class="text-lg font-bold text-[#07172D]">實驗筆記撰寫審閱中</h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          最新一期的 Prompt 結構測試、本地推理速度基準與模型長文本表現評測筆記正在校稿中。
          完成後將與 AI Skills 技能庫連動發布。
        </p>
        <div class="pt-2">
          <a href="/skills" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#155EEF] text-white text-xs font-semibold hover:bg-blue-700 transition-colors">
            先探索 AI Skills 技能庫 &rarr;
          </a>
        </div>
      </div>
    )}
  </div>
</MainLayout>
