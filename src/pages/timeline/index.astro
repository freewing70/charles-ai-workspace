---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllItems } from '../../lib/content';
import { getContentRoute } from '../../lib/assets';

const items = getAllItems(false);

const groupsMap = new Map<string, typeof items>();

for (const item of items) {
  const period = item.meta.created.slice(0, 7); // YYYY-MM
  if (!groupsMap.has(period)) {
    groupsMap.set(period, []);
  }
  groupsMap.get(period)!.push(item);
}

const sortedPeriods = Array.from(groupsMap.keys()).sort((a, b) => b.localeCompare(a));
---

<MainLayout title="歷程時間軸 (Timeline)">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="JOURNEY"
      title="AI 工作與創作時間軸"
      description="依建立時間回顧 FreewingBiz 歷來的各項 Skill 發布、專案上線與線上簡報軌跡。"
      badge={`${items.length} 個里程碑`}
    />

    <!-- Timeline Vertical Line Container -->
    <div class="relative border-l-2 border-slate-200 ml-4 sm:ml-8 space-y-12">
      {sortedPeriods.map(period => {
        const periodItems = groupsMap.get(period)!;
        return (
          <div class="relative pl-6 sm:pl-10">
            <!-- Period Pin -->
            <div class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-[#155EEF] border-4 border-white shadow-sm"></div>
            
            <div class="text-base font-mono font-bold text-[#155EEF] mb-6 flex items-center gap-2">
              <span>{period}</span>
              <span class="text-xs font-normal text-slate-500 font-sans">({periodItems.length} 個發布)</span>
            </div>

            <div class="space-y-4">
              {periodItems.map(item => (
                <div class="freewing-card p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-slate-200">
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-[10px] font-mono font-semibold uppercase px-2 py-0.5 rounded bg-blue-50 text-[#155EEF] border border-blue-200">
                        {item.meta.type}
                      </span>
                      <time datetime={item.meta.created} class="text-xs font-mono text-slate-500">
                        {item.meta.created}
                      </time>
                      <span class="text-xs font-mono text-slate-400">v{item.meta.version}</span>
                    </div>
                    <h3 class="text-base font-bold text-[#07172D] hover:text-[#155EEF] transition-colors">
                      <a href={getContentRoute(item.meta.type, item.meta.id)}>
                        {item.meta.title}
                      </a>
                    </h3>
                    <p class="text-sm text-slate-600 mt-1 line-clamp-1">{item.meta.summary}</p>
                  </div>
                  <a
                    href={getContentRoute(item.meta.type, item.meta.id)}
                    class="self-start sm:self-center px-4 py-2 rounded-xl bg-slate-50 hover:bg-blue-50 text-xs text-[#07172D] hover:text-[#155EEF] font-semibold border border-slate-200 hover:border-blue-200 transition-colors whitespace-nowrap shadow-2xs"
                  >
                    檢視內容 &rarr;
                  </a>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</MainLayout>
