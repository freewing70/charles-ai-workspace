---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAssetUrl } from '../../lib/assets';

const pageTitle = "AI 電影運鏡工程模擬器：40 款標準鏡頭語言 × 雙視角 3D 即時模擬 × 提示詞生成器";
const pageDescription = "專為 AI 網劇與短影音創作者打造的 3D 電影運鏡工程模擬器。整合 40 款標準鏡頭語言、雙視角空間透視模擬台、5 大爆款短劇黃金分鏡模板，並支援可靈 Kling、Runway、Luma、Sora 與 Wan 2.1 提示詞一鍵轉譯輸出。";
const coverUrl = getAssetUrl('/assets/covers/camera-controls.svg');
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={coverUrl}
  type="article"
  contentType="skill"
  publishedDate="2026-10-27"
  modifiedDate="2026-10-27"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
      <a href="/" class="hover:text-[#155EEF] transition-colors">首頁</a>
      <span>/</span>
      <a href="/skills" class="hover:text-[#155EEF] transition-colors">Skills</a>
      <span>/</span>
      <span class="text-[#07172D] font-bold">camera-controls</span>
    </nav>

    <!-- Header Hero Card -->
    <header class="freewing-card p-6 sm:p-10 border border-slate-200 bg-gradient-to-br from-slate-900 via-[#07172D] to-slate-900 text-white shadow-xl relative overflow-hidden">
      <!-- Background Ambient Glow -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl">
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
          <span class="text-xs font-mono font-bold uppercase px-3 py-1 rounded-full bg-blue-500/20 text-[#27A8FF] border border-blue-400/30">
            AI CINEMATOGRAPHY
          </span>
          <span class="text-xs font-mono px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            40 標準運鏡矩陣
          </span>
          <span class="text-xs font-mono px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">
            雙視角 3D 即時模擬
          </span>
          <span class="text-xs font-mono px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
            短劇分鏡模板
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 leading-tight">
          AI 電影運鏡工程模擬器
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl mb-6">
          不要盲目抽卡消耗算力。以精確的攝影物理坐標為基礎，透過雙視角 3D 空間透視即時預覽 40 款標準運鏡語言，並一鍵編譯輸出可靈 Kling、Runway Gen-3/4、Luma、Sora 與 Wan 2.1 影視級提示詞。
        </p>

        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-400 pt-4 border-t border-slate-800">
          <div><span class="text-slate-500">適用平台:</span> <span class="text-slate-200 font-semibold">可靈 Kling · Runway · Luma · Sora · Wan 2.1 · ComfyUI</span></div>
          <div><span class="text-slate-500">&bull;</span></div>
          <div><span class="text-slate-500">核心優勢:</span> <span class="text-amber-300 font-semibold">零依賴純前端 3D 渲染 · 毫秒級即時互動</span></div>
        </div>
      </div>
    </header>

    <!-- SECTION 1: DUAL-VIEWPORT 3D SIMULATOR STAGE -->
    <section class="space-y-4" aria-label="運鏡模擬核心視窗">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#07172D] flex items-center gap-2">
            <span>雙視角空間透視模擬台</span>
            <span class="text-xs font-mono font-medium px-2.5 py-0.5 rounded-full bg-blue-100 text-[#155EEF]">Dual 3D Viewport</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">左側顯示攝影機鏡頭觀景窗視角，右側顯示三維空間機位軌跡與視錐台運動。</p>
        </div>

        <!-- Global Playback Controls -->
        <div class="flex items-center gap-2 bg-white p-1.5 rounded-xl border border-slate-200 shadow-2xs">
          <button id="btn-toggle-play" class="px-3 py-1.5 rounded-lg bg-[#155EEF] hover:bg-[#0D47C2] text-white text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
            <svg id="icon-pause" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            <svg id="icon-play" class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span id="label-play">暫停動畫</span>
          </button>
          <div class="h-4 w-px bg-slate-200"></div>
          <button id="btn-speed-toggle" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 text-xs font-mono font-semibold transition-colors cursor-pointer" title="切換動畫速度">
            速度: <span id="label-speed">1.0x</span>
          </button>
          <div class="h-4 w-px bg-slate-200"></div>
          <button id="btn-toggle-grid" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-700 text-xs font-mono font-semibold transition-colors cursor-pointer" title="切換構圖線">
            構圖九宮格: <span id="label-grid" class="text-emerald-700 font-bold">開</span>
          </button>
          <div class="h-4 w-px bg-slate-200"></div>
          <button id="btn-reset-cam" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-slate-600 text-xs font-mono transition-colors cursor-pointer" title="重設機位">
            重設機位
          </button>
        </div>
      </div>

      <!-- Viewports Container Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Viewport A: Camera Viewfinder (觀景窗視角) -->
        <div class="freewing-card border border-slate-300 bg-slate-950 rounded-2xl overflow-hidden shadow-xl flex flex-col">
          <!-- Monitor Top HUD -->
          <div class="bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center justify-between text-[11px] font-mono text-slate-400 select-none">
            <div class="flex items-center gap-2.5">
              <span class="flex items-center gap-1 text-rose-500 font-bold animate-pulse">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                <span>REC</span>
              </span>
              <span class="text-slate-500">|</span>
              <span class="text-slate-300">4K DCI · 60 FPS</span>
              <span class="text-slate-500">|</span>
              <span class="text-amber-400 font-bold" id="hud-movement-name">PAN LEFT (左水平搖鏡)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-300 font-mono" id="hud-lens-spec">35mm · F/1.8</span>
              <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px] text-emerald-400 font-bold">LOG-C</span>
            </div>
          </div>

          <!-- The 3D Viewfinder Stage -->
          <div class="relative w-full aspect-video bg-gradient-to-b from-[#071325] via-[#0D1F3C] to-[#040915] overflow-hidden flex items-center justify-center select-none" style="perspective: 750px;">
            
            <!-- Grid Lines (Rule of Thirds Overlay) -->
            <div id="rule-of-thirds-grid" class="absolute inset-0 pointer-events-none z-20 transition-opacity duration-300">
              <div class="w-full h-full border border-white/10 relative">
                <!-- Vertical lines -->
                <div class="absolute left-1/3 top-0 bottom-0 w-px bg-cyan-400/25 border-dashed"></div>
                <div class="absolute left-2/3 top-0 bottom-0 w-px bg-cyan-400/25 border-dashed"></div>
                <!-- Horizontal lines -->
                <div class="absolute top-1/3 left-0 right-0 h-px bg-cyan-400/25 border-dashed"></div>
                <div class="absolute top-2/3 left-0 right-0 h-px bg-cyan-400/25 border-dashed"></div>
                <!-- Center Target Crosshair -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-6 h-6 pointer-events-none opacity-40">
                  <div class="w-full h-px bg-amber-400 absolute top-1/2"></div>
                  <div class="h-full w-px bg-amber-400 absolute left-1/2"></div>
                </div>
              </div>
            </div>

            <!-- Viewport 3D Dynamic Stage World -->
            <div id="viewfinder-stage" class="w-full h-full relative transition-transform duration-100 ease-out flex items-center justify-center" style="transform-style: preserve-3d;">
              
              <!-- Layer 1: Background Distant Skyline / Horizon -->
              <div id="layer-horizon" class="absolute inset-x-0 bottom-1/3 h-32 flex items-end justify-between px-8 opacity-30 pointer-events-none transition-transform duration-200">
                <div class="w-16 h-28 bg-blue-400/30 rounded-t"></div>
                <div class="w-24 h-40 bg-blue-300/20 rounded-t"></div>
                <div class="w-12 h-20 bg-blue-400/25 rounded-t"></div>
                <div class="w-32 h-48 bg-blue-200/20 rounded-t"></div>
                <div class="w-20 h-32 bg-blue-400/30 rounded-t"></div>
                <div class="w-28 h-44 bg-blue-300/20 rounded-t"></div>
              </div>

              <!-- Layer 2: 3D Ground Perspective Grid -->
              <div class="absolute -bottom-20 w-[160%] h-64 opacity-35" style="transform: rotateX(75deg); background: radial-gradient(circle, rgba(0,242,254,0.3) 0%, transparent 70%), repeating-linear-gradient(0deg, #00F2FE 0px, #00F2FE 1px, transparent 1px, transparent 24px), repeating-linear-gradient(90deg, #00F2FE 0px, #00F2FE 1px, transparent 1px, transparent 24px);"></div>

              <!-- Layer 3: Central Subject (3D Stylized Character / Mannequin) -->
              <div id="subject-anchor" class="relative z-10 flex flex-col items-center transition-all duration-200" style="transform-style: preserve-3d;">
                <!-- Character Head -->
                <div class="w-12 h-14 rounded-full bg-gradient-to-b from-amber-200 to-amber-400 border border-amber-100 shadow-md flex items-center justify-center relative">
                  <div class="w-7 h-2 rounded bg-amber-800/40 mt-1"></div>
                </div>
                <!-- Character Torso (Trench Coat) -->
                <div class="w-20 h-28 bg-gradient-to-b from-blue-700 to-slate-900 rounded-t-xl rounded-b-lg border border-blue-400/30 shadow-lg mt-1 relative flex justify-center">
                  <div class="w-1 h-full bg-amber-400/40"></div>
                </div>
                <!-- Character Legs -->
                <div class="flex gap-2 -mt-1">
                  <div class="w-6 h-20 bg-slate-900 border-x border-slate-700"></div>
                  <div class="w-6 h-20 bg-slate-900 border-x border-slate-700"></div>
                </div>
                <!-- Ground Shadow -->
                <div class="w-28 h-6 bg-black/60 rounded-full blur-xs -mt-2"></div>
              </div>

              <!-- Layer 4: Foreground Elements for Parallax (Pillars / Streetlights) -->
              <div id="layer-foreground-left" class="absolute -left-12 top-4 w-10 h-72 bg-gradient-to-r from-slate-950 to-slate-800 border-r border-cyan-400/30 opacity-70 transition-transform duration-150"></div>
              <div id="layer-foreground-right" class="absolute -right-12 top-4 w-10 h-72 bg-gradient-to-l from-slate-950 to-slate-800 border-l border-cyan-400/30 opacity-70 transition-transform duration-150"></div>
            </div>

            <!-- Layer 5: Over-the-Shoulder Foreground Silhouette (for OTS shot) -->
            <div id="layer-ots-shoulder" class="absolute -bottom-8 -left-6 w-44 h-56 bg-slate-950/95 rounded-t-full border-t-2 border-r-2 border-slate-700/60 z-25 pointer-events-none opacity-0 transition-opacity duration-300">
              <div class="absolute top-4 right-6 w-16 h-16 rounded-full bg-slate-900 border border-slate-700"></div>
            </div>

            <!-- Layer 6: Dynamic Speed Lines & Motion Blur FX Overlay (for FPV dive, Crash zoom, Whip pan) -->
            <div id="layer-fx-speed" class="absolute inset-0 z-25 pointer-events-none opacity-0 transition-opacity duration-150" style="background: radial-gradient(circle, transparent 40%, rgba(0,242,254,0.25) 100%), repeating-radial-gradient(circle, transparent 0, transparent 20px, rgba(255,255,255,0.12) 21px, transparent 24px);"></div>

            <!-- Layer 7: Split Diopter Optical Divider Line (for Split Diopter) -->
            <div id="layer-split-line" class="absolute inset-y-0 left-1/2 w-0.5 bg-cyan-400 shadow-[0_0_12px_#00F2FE] z-25 pointer-events-none opacity-0 transition-opacity duration-300"></div>

            <!-- Viewfinder Safety Markers (Corner Brackets) -->
            <div class="absolute inset-4 pointer-events-none border border-white/10 z-20">
              <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-amber-400"></div>
              <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-amber-400"></div>
              <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-amber-400"></div>
              <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-amber-400"></div>
            </div>
          </div>

          <!-- Monitor Bottom Bar -->
          <div class="bg-slate-900/90 border-t border-slate-800 px-4 py-2 flex items-center justify-between text-xs text-slate-400 font-mono">
            <div class="flex items-center gap-2">
              <span class="text-slate-500">主體距離:</span>
              <span id="hud-subject-distance" class="text-cyan-400 font-bold">2.4 m</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500">鏡頭運動向量:</span>
              <span id="hud-vector-text" class="text-amber-400 font-bold">Yaw: -18.0°</span>
            </div>
          </div>
        </div>

        <!-- Viewport B: God's Eye 3D Coordinate Stage (上帝機位俯瞰視角) -->
        <div class="freewing-card border border-slate-300 bg-slate-950 rounded-2xl overflow-hidden shadow-xl flex flex-col">
          <!-- Rig HUD Header -->
          <div class="bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center justify-between text-[11px] font-mono text-slate-400 select-none">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              <span class="text-slate-200 font-bold">3D RIG COORDINATES (機位空間圖)</span>
            </div>
            <span class="text-cyan-400 font-bold">ISOMETRIC 3D</span>
          </div>

          <!-- The Isometric 3D Stage -->
          <div class="relative w-full aspect-video bg-[#050C17] overflow-hidden flex items-center justify-center select-none" style="perspective: 900px;">
            
            <!-- Isometric Rotation Wrapper -->
            <div id="god-eye-stage" class="w-72 h-72 relative flex items-center justify-center transition-transform duration-200 ease-out" style="transform-style: preserve-3d; transform: rotateX(55deg) rotateZ(-35deg);">
              
              <!-- 3D Grid Floor -->
              <div class="absolute inset-0 border border-cyan-500/30 rounded-xl" style="background: repeating-linear-gradient(0deg, rgba(0,242,254,0.15) 0px, rgba(0,242,254,0.15) 1px, transparent 1px, transparent 28px), repeating-linear-gradient(90deg, rgba(0,242,254,0.15) 0px, rgba(0,242,254,0.15) 1px, transparent 1px, transparent 28px);">
                <!-- Coordinate Axis Indicators -->
                <div class="absolute top-1/2 left-0 right-0 h-px bg-rose-500/50"></div>
                <div class="absolute left-1/2 top-0 bottom-0 w-px bg-emerald-500/50"></div>
              </div>

              <!-- Center Target Subject (The Yellow Marker) -->
              <div class="absolute w-8 h-8 rounded-full bg-amber-400 border-2 border-white shadow-[0_0_15px_rgba(251,191,36,0.8)] z-10 flex items-center justify-center text-[10px] font-bold text-slate-950 font-mono">
                ACT
              </div>

              <!-- Orbit Path Guide Circle -->
              <div class="absolute w-48 h-48 rounded-full border border-dashed border-cyan-400/30 pointer-events-none"></div>

              <!-- Virtual Camera Body & Frustum (The Moving Rig) -->
              <div id="camera-rig-marker" class="absolute z-20 flex flex-col items-center transition-all duration-100 ease-out" style="transform: translate3d(0px, 85px, 0px) rotateZ(0deg);">
                <!-- Camera Frustum Cone (Light field) -->
                <div class="w-24 h-32 -mb-2 bg-gradient-to-t from-cyan-400/25 to-transparent clip-frustum pointer-events-none"></div>
                <!-- Camera Icon / Body -->
                <div class="w-7 h-7 bg-rose-600 rounded-md border-2 border-white shadow-[0_0_12px_rgba(244,63,94,0.9)] flex items-center justify-center text-[9px] font-mono font-bold text-white">
                  CAM
                </div>
                <!-- Orientation Pointer Arrow -->
                <div class="w-0.5 h-6 bg-rose-400 mt-0.5"></div>
              </div>
            </div>

            <!-- Coordinate Axes Label Overlay -->
            <div class="absolute bottom-3 left-4 text-[10px] font-mono text-slate-500 space-y-0.5 pointer-events-none">
              <div><span class="text-rose-400 font-bold">X軸 (紅)</span>: 水平推軌 (Truck)</div>
              <div><span class="text-emerald-400 font-bold">Y軸 (綠)</span>: 前後推拉 (Dolly)</div>
              <div><span class="text-cyan-400 font-bold">Z軸 (藍)</span>: 垂直升降 (Pedestal)</div>
            </div>
          </div>

          <!-- Rig Bottom HUD Coordinates -->
          <div class="bg-slate-900/90 border-t border-slate-800 px-4 py-2 flex items-center justify-between text-xs text-slate-400 font-mono">
            <div class="flex items-center gap-2">
              <span class="text-slate-500">實體機位座標:</span>
              <span id="rig-coord-text" class="text-emerald-400 font-bold">X: 0.0m, Y: -2.4m, Z: 1.2m</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500">俯仰/旋轉:</span>
              <span id="rig-rot-text" class="text-cyan-400 font-bold">P: 0°, Y: 0°, R: 0°</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 2: 40 CAMERA MOVEMENTS PALETTE & SELECTOR -->
    <section class="freewing-card p-6 sm:p-8 border border-slate-200" aria-label="40款標準運鏡選擇器">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-[#07172D] flex items-center gap-2">
            <span>40 款工業級標準運鏡語言矩陣</span>
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-100 text-[#B45309]">點擊即時測試</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
            點擊任一運鏡晶片，上方 3D 模擬台將同步演算透視位移，下方將即時編譯各模型 Prompt。
          </p>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap items-center gap-1.5" id="category-filter-buttons">
          <button data-cat="all" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#155EEF] text-white shadow-2xs transition-all cursor-pointer">全部 (40)</button>
          <button data-cat="physical" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:text-slate-900 transition-all cursor-pointer">基礎物理位移 (12)</button>
          <button data-cat="optical" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:text-slate-900 transition-all cursor-pointer">鏡頭焦段光學 (6)</button>
          <button data-cat="compound" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:text-slate-900 transition-all cursor-pointer">複合軌跡載具 (14)</button>
          <button data-cat="special" class="cat-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:text-slate-900 transition-all cursor-pointer">電影特殊視角 (8)</button>
        </div>
      </div>

      <!-- Quick Search Bar -->
      <div class="mb-6 relative">
        <input
          type="text"
          id="movement-search-input"
          placeholder="搜尋運鏡關鍵字（如：dolly, 搖鏡, 變焦, 俯衝, 追逐, orbit）..."
          class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-10 pr-4 py-2.5 text-sm text-[#07172D] placeholder-slate-400 focus:outline-none focus:border-[#155EEF] focus:bg-white focus:ring-2 focus:ring-[#155EEF]/10 font-medium transition-all"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <!-- Movement Chips Grid (Injected / Rendered via Script) -->
      <div id="movement-chips-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 max-h-[460px] overflow-y-auto pr-1">
        <!-- Rendered by Client Script -->
      </div>
    </section>

    <!-- SECTION 3: MULTI-MODEL PROMPT COMPILER & SYNTAX EXPORTER -->
    <section class="freewing-card p-6 sm:p-10 border border-slate-200 bg-slate-900 text-white shadow-xl" aria-label="提示詞編譯產生器">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-800">
        <div>
          <span class="text-xs font-mono uppercase font-bold text-amber-400 tracking-wider block mb-1">PROMPT COMPILER</span>
          <h2 class="text-2xl font-bold text-white flex items-center gap-2">
            AI 影視提示詞一鍵編譯器
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
