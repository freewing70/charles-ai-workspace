    // 4. Mode Switching Handlers (Single vs Combo)
    function switchToSingleMode(autoSelectCurrent = true) {
      isComboMode = false;
      tabModeSingle.classList.add('bg-[#155EEF]', 'text-white', 'shadow-2xs');
      tabModeSingle.classList.remove('text-slate-600');
      tabModeCombo.classList.remove('bg-[#155EEF]', 'text-white', 'shadow-2xs');
      tabModeCombo.classList.add('text-slate-600');

      panelSingleShot.classList.remove('hidden');
      panelStoryboardCombo.classList.add('hidden');
      sbTimelineBar.classList.add('hidden');

      if (autoSelectCurrent) {
        selectMovement(currentMovement);
      }
    }

    function switchToComboMode(comboKey = 'hero') {
      isComboMode = true;
      activeComboKey = comboKey;
      comboTime = 0;

      tabModeCombo.classList.add('bg-[#155EEF]', 'text-white', 'shadow-2xs');
      tabModeCombo.classList.remove('text-slate-600');
      tabModeSingle.classList.remove('bg-[#155EEF]', 'text-white', 'shadow-2xs');
      tabModeSingle.classList.add('text-slate-600');

      panelSingleShot.classList.add('hidden');
      panelStoryboardCombo.classList.remove('hidden');
      sbTimelineBar.classList.remove('hidden');

      const combo = STORYBOARD_COMBOS[comboKey];
      sbComboBadge.textContent = `${combo.badge} · ${combo.name}`;

      // Highlight active combo card
      comboCards.forEach(card => {
        if (card.dataset.combo === comboKey) {
          card.classList.add('bg-blue-50/80', 'border-blue-500', 'ring-2', 'ring-blue-500/20');
          card.classList.remove('bg-white');
        } else {
          card.classList.remove('bg-blue-50/80', 'border-blue-500', 'ring-2', 'ring-blue-500/20');
          card.classList.add('bg-white');
        }
      });

      updateCompiledPrompt();
    }

    // 5. Animation Loop for 3D Viewport Physics (ALL 40 MOVEMENTS + 5 STORYBOARD COMBOS)
    let lastRenderedMId = '';

    function animateLoop() {
      let mId = currentMovement.id;
      let t = 0;
      let tNorm = 0;
      let p = 0;

      if (isPlaying) {
        animProgress += 0.018 * animationSpeed;
        if (isComboMode) {
          comboTime += 0.016 * animationSpeed;
        }
      }

      const activeProgress = isComboMode ? (comboTime * 2.5) : animProgress;

      if (isComboMode) {
        const combo = STORYBOARD_COMBOS[activeComboKey];
        const cycleTime = comboTime % 9; // 0 to 9 seconds cycle
        let shotIndex = 0;
        let shotLocalTime = 0;

        if (cycleTime < 3) {
          shotIndex = 0;
          shotLocalTime = cycleTime / 3;
          sbProgress1.style.width = `${shotLocalTime * 100}%`;
          sbProgress2.style.width = '0%';
          sbProgress3.style.width = '0%';
        } else if (cycleTime < 6) {
          shotIndex = 1;
          shotLocalTime = (cycleTime - 3) / 3;
          sbProgress1.style.width = '100%';
          sbProgress2.style.width = `${shotLocalTime * 100}%`;
          sbProgress3.style.width = '0%';
        } else {
          shotIndex = 2;
          shotLocalTime = (cycleTime - 6) / 3;
          sbProgress1.style.width = '100%';
          sbProgress2.style.width = '100%';
          sbProgress3.style.width = `${shotLocalTime * 100}%`;
        }

        const activeShot = combo.shots[shotIndex];
        mId = activeShot.id;
        p = Math.max(0, Math.min(1, shotLocalTime)); // 0.0 to 1.0 linear progress
        t = Math.sin(shotLocalTime * Math.PI * 2);
        tNorm = (t + 1) / 2;

        sbShotIndicator.textContent = `分鏡 ${shotIndex + 1}/3: ${activeShot.name} (${shotIndex * 3}s-${(shotIndex + 1) * 3}s) · ${activeShot.desc}`;
        hudMovementName.textContent = `[${shotIndex + 1}/3] ${activeShot.name.toUpperCase()}`;

        // Reset visual layers when switching shot in combo
        if (lastRenderedMId !== mId) {
          resetVisualModifiers();
          lastRenderedMId = mId;
        }
      } else {
        t = Math.sin(animProgress); // -1 to 1 oscillation
        tNorm = (t + 1) / 2; // 0 to 1 smooth oscillation
        p = tNorm;
        lastRenderedMId = mId;
      }

      let vfRotX = 0, vfRotY = 0, vfRotZ = 0, vfTransX = 0, vfTransY = 0, vfTransZ = 0, vfScale = 1;
      let rigTransX = 0, rigTransY = 85, rigTransZ = 0, rigRotZ = 0;
      let horizonOffset = 0;

      // Coordinate HUD outputs
      let posX = 0, posY = -2.4, posZ = 1.2;
      let rotP = 0, rotY = 0, rotR = 0;
      let vectorDesc = '';

      switch (mId) {
        // Physical (12) - Pure directional kinematics with zero oscillating shakes
        case 'pan-left':
          const panLP = isComboMode ? p : tNorm;
          rotY = -35 * panLP;
          vfRotY = -30 * panLP;
          rigRotZ = -38 * panLP;
          horizonOffset = 38 * panLP;
          vectorDesc = `Yaw: ${rotY.toFixed(1)}° (Pan Left)`;
          break;

        case 'pan-right':
          const panRP = isComboMode ? p : tNorm;
          rotY = 35 * panRP;
          vfRotY = 30 * panRP;
          rigRotZ = 38 * panRP;
          horizonOffset = -38 * panRP;
          vectorDesc = `Yaw: +${rotY.toFixed(1)}° (Pan Right)`;
          break;

        case 'tilt-up':
          const tiltUP = isComboMode ? p : tNorm;
          rotP = 28 * tiltUP;
          vfRotX = 25 * tiltUP;
          vfTransY = -20 * tiltUP;
          rigTransY = 85 - 18 * tiltUP;
          vectorDesc = `Pitch: +${rotP.toFixed(1)}° (Tilt Up)`;
          break;

        case 'tilt-down':
          const tiltDP = isComboMode ? p : tNorm;
          rotP = -28 * tiltDP;
          vfRotX = -25 * tiltDP;
          vfTransY = 20 * tiltDP;
          rigTransY = 85 + 18 * tiltDP;
          vectorDesc = `Pitch: ${rotP.toFixed(1)}° (Tilt Down)`;
          break;

        case 'roll-cw':
          const rollP = isComboMode ? p : tNorm;
          rotR = 35 * rollP;
          vfRotZ = 35 * rollP;
          vectorDesc = `Roll: +${rotR.toFixed(1)}° CW`;
          break;

        case 'roll-ccw':
          const rollCCWP = isComboMode ? p : tNorm;
          rotR = -35 * rollCCWP;
          vfRotZ = -35 * rollCCWP;
          vectorDesc = `Roll: ${rotR.toFixed(1)}° CCW`;
          break;

        case 'dolly-in':
          const dinP = isComboMode ? p : tNorm;
          vfScale = 1 + 0.6 * dinP;
          rigTransY = 85 - 55 * dinP;
          posY = -2.4 + 1.6 * dinP;
          vectorDesc = `Dolly: +${(1.6 * dinP).toFixed(2)}m (Forward)`;
          break;

        case 'dolly-out':
          const doutP = isComboMode ? p : tNorm;
          vfScale = 1.45 - 0.5 * doutP;
          rigTransY = 35 + 65 * doutP;
          posY = -0.8 - 2.0 * doutP;
          vectorDesc = `Dolly: -${(2.0 * doutP).toFixed(2)}m (Backward)`;
          break;

        case 'truck-left':
          const trkLP = isComboMode ? p : tNorm;
          posX = 1.8 * trkLP;
          vfTransX = 45 * trkLP;
          rigTransX = 48 * trkLP;
          horizonOffset = -18 * trkLP;
          vectorDesc = `Truck X: -${posX.toFixed(2)}m (Left)`;
          break;

        case 'truck-right':
          const trkRP = isComboMode ? p : tNorm;
          posX = -1.8 * trkRP;
          vfTransX = -45 * trkRP;
          rigTransX = -48 * trkRP;
          horizonOffset = 18 * trkRP;
          vectorDesc = `Truck X: +${Math.abs(posX).toFixed(2)}m (Right)`;
          break;

        case 'pedestal-up':
          const pedUP = isComboMode ? p : tNorm;
          posZ = 1.2 + 1.2 * pedUP;
          vfTransY = 35 * pedUP;
          rigTransZ = -30 * pedUP;
          vectorDesc = `Pedestal Z: +${posZ.toFixed(2)}m (Up)`;
          break;

        case 'pedestal-down':
          const pedDP = isComboMode ? p : tNorm;
          posZ = 1.2 - 0.9 * pedDP;
          vfTransY = -35 * pedDP;
          rigTransZ = 30 * pedDP;
          vectorDesc = `Pedestal Z: ${posZ.toFixed(2)}m (Down)`;
          break;

        // Optical (6)
        case 'zoom-in':
          const zinP = isComboMode ? p : tNorm;
          vfScale = 1 + 0.65 * zinP;
          vectorDesc = `Optical Zoom In: ${(35 + 50 * zinP).toFixed(0)}mm`;
          break;

        case 'zoom-out':
          const zoutP = isComboMode ? p : tNorm;
          vfScale = 1.45 - 0.6 * zoutP;
          vectorDesc = `Optical Zoom Out: ${(85 - 55 * zoutP).toFixed(0)}mm`;
          break;

        case 'crash-zoom':
          const crashFactor = isComboMode ? Math.pow(p, 2.5) : Math.pow(tNorm, 3);
          vfScale = 0.95 + 1.25 * crashFactor;
          if (crashFactor > 0.35 && layerFxSpeed) {
            layerFxSpeed.style.opacity = `${(crashFactor - 0.35) * 2.2}`;
          }
          vectorDesc = `Crash Zoom: ${(35 + 90 * crashFactor).toFixed(0)}mm (Rapid Snap)`;
          break;

        case 'rack-focus':
          const focusDist = isComboMode ? p : tNorm;
          if (focusDist > 0.5) {
            horizonLayer.style.filter = `blur(${(focusDist - 0.5) * 18}px)`;
            subjectAnchor.style.filter = 'blur(0px)';
            vectorDesc = `Rack Focus: Foreground Target Sharp (${((focusDist - 0.5) * 200).toFixed(0)}%)`;
          } else {
            subjectAnchor.style.filter = `blur(${(0.5 - focusDist) * 16}px)`;
            horizonLayer.style.filter = 'blur(0px)';
            vectorDesc = `Rack Focus: Background Environment Sharp`;
          }
          break;

        case 'deep-focus':
          subjectAnchor.style.filter = 'blur(0px)';
          horizonLayer.style.filter = 'blur(0px)';
          vfScale = 1.05 + 0.03 * Math.sin(activeProgress * 1.5);
          vfTransX = Math.sin(activeProgress * 1.2) * 2;
          vectorDesc = `Deep Focus: F/11 (Inf. Hyperfocal)`;
          break;

        case 'shallow-dof':
          horizonLayer.style.filter = 'blur(10px)';
          subjectAnchor.style.filter = 'blur(0px)';
          subjectAnchor.style.boxShadow = '0 0 25px rgba(0, 242, 254, 0.4)';
          vfScale = 1.02 + 0.04 * Math.sin(activeProgress * 1.5);
          vfTransX = Math.cos(activeProgress * 1.2) * 2.5;
          vectorDesc = `Shallow DOF: F/1.4 Creamy Bokeh`;
          break;

        // Compound (14)
        case 'orbit-360':
          const orbAngle = isComboMode ? (p * Math.PI * 2) : ((activeProgress * 1.5) % (Math.PI * 2));
          vfRotY = -Math.sin(orbAngle) * 35;
          horizonOffset = Math.sin(orbAngle) * 60;
          rigTransX = Math.cos(orbAngle) * 75;
          rigTransY = Math.sin(orbAngle) * 75;
          rigRotZ = (orbAngle * 180 / Math.PI) - 90;
          posX = 2.4 * Math.cos(orbAngle);
          posY = 2.4 * Math.sin(orbAngle);
          rotY = (orbAngle * 180 / Math.PI) % 360;
          vectorDesc = `Orbit 360°: ${rotY.toFixed(0)}° (King Reveal)`;
          break;

        case 'arc-left':
          const arcAngleL = isComboMode ? (p * Math.PI * 0.7 - Math.PI * 0.2) : ((tNorm * Math.PI * 0.5) - Math.PI * 0.25);
          vfRotY = -arcAngleL * (180 / Math.PI);
          rigTransX = Math.sin(arcAngleL) * 80;
          rigTransY = Math.cos(arcAngleL) * 80;
          rigRotZ = -arcAngleL * (180 / Math.PI);
          rotY = -arcAngleL * (180 / Math.PI);
          horizonOffset = arcAngleL * 40;
          vectorDesc = `Arc Left 90°: ${rotY.toFixed(1)}° (Reveal Crowd)`;
          break;

        case 'arc-right':
          const arcAngleR = isComboMode ? (p * Math.PI * 0.7 - Math.PI * 0.2) : ((tNorm * Math.PI * 0.5) - Math.PI * 0.25);
          vfRotY = arcAngleR * (180 / Math.PI);
          rigTransX = -Math.sin(arcAngleR) * 80;
          rigTransY = Math.cos(arcAngleR) * 80;
          rigRotZ = arcAngleR * (180 / Math.PI);
          rotY = arcAngleR * (180 / Math.PI);
          horizonOffset = -arcAngleR * 40;
          vectorDesc = `Arc Right 90°: +${rotY.toFixed(1)}°`;
          break;

        case 'lead-tracking':
          const leadStep = activeProgress * 3;
          const leadP = isComboMode ? p : tNorm;
          vfScale = 1.05 + 0.12 * Math.sin(leadStep) + (isComboMode ? leadP * 0.1 : 0);
          vfTransY = Math.sin(leadStep * 2) * 3.5;
          vfTransX = Math.sin(leadStep) * 2;
          rigTransY = 70 + (isComboMode ? leadP * 25 : Math.sin(leadStep) * 10);
          posY = -2.2 + 0.3 * Math.sin(leadStep);
          vectorDesc = `Lead Track: Reverse Glide (Step Cadence)`;
          break;

        case 'trail-tracking':
          const trailStep = activeProgress * 3;
          const trailP = isComboMode ? p : tNorm;
          vfScale = 0.95 + 0.12 * Math.sin(trailStep) - (isComboMode ? trailP * 0.1 : 0);
          vfTransY = Math.sin(trailStep * 2) * 4;
          vfTransX = Math.cos(trailStep) * 2;
          rigTransY = 100 - (isComboMode ? trailP * 25 : Math.sin(trailStep) * 10);
          posY = -3.2 + 0.3 * Math.sin(trailStep);
          vectorDesc = `Trail Track: Chasing Behind`;
          break;

        case 'side-tracking':
          const sideStep = activeProgress * 3;
          vfTransX = 35 * t;
          vfTransY = Math.sin(sideStep * 2) * 2.5;
          horizonOffset = -60 * t;
          rigTransX = 50 * t;
          vectorDesc = `Side Tracking (Profile Match)`;
          break;

        case 'dolly-zoom':
          const dz = isComboMode ? p : tNorm;
          vfScale = 1.0;
          horizonLayer.style.transform = `scale(${1 + 0.85 * dz}) translateY(${dz * 26}px)`;
          rigTransY = 85 - 65 * dz;
          posY = -2.4 + 2.0 * dz;
          vectorDesc = `Vertigo Dolly Zoom: Z=${posY.toFixed(2)}m (BG Distorting)`;
          break;

        case 'whip-pan':
          const whipT = isComboMode ? Math.sin(p * Math.PI) : t;
          const whipPhase = Math.abs(whipT);
          if (whipPhase > 0.45) {
            viewfinderStage.style.filter = `blur(${(whipPhase - 0.45) * 20}px)`;
            if (layerFxSpeed) layerFxSpeed.style.opacity = `${(whipPhase - 0.45) * 2.2}`;
            vfRotY = Math.sign(whipT || 1) * 70 * whipPhase;
            vectorDesc = `Whip Pan: Swish Flash Blur!`;
          } else {
            viewfinderStage.style.filter = 'none';
            if (layerFxSpeed) layerFxSpeed.style.opacity = '0';
            vfRotY = whipT * 30;
            vectorDesc = `Whip Pan Kinetic Sweep`;
          }
          break;

        case 'handheld-shaky':
          vfTransX = Math.sin(activeProgress * 2.1) * 9;
          vfRotZ = Math.sin(activeProgress * 2.1) * 2.2;
          vfTransY = Math.cos(activeProgress * 3.3) * 7;
          vfRotX = Math.sin(activeProgress * 1.7) * 2.5;
          rotP = vfRotX;
          rotR = vfRotZ;
          vectorDesc = `Handheld Natural Breathing Shake`;
          break;

        case 'steadicam':
          vfTransX = Math.sin(activeProgress * 0.8) * 18;
          vfTransY = Math.sin(activeProgress * 1.6) * 4;
          vfScale = 1.02 + 0.08 * Math.cos(activeProgress * 0.8);
          rigTransX = vfTransX * 0.8;
          vectorDesc = `Steadicam Ultra-Smooth Glide`;
          break;

        case 'crane-shot':
          const craneP = isComboMode ? p : tNorm;
          vfTransY = -70 + craneP * 70;
          vfRotX = 35 - craneP * 35;
          vfScale = 0.75 + craneP * 0.45;
          rigTransZ = -70 + craneP * 70;
          rigTransY = 120 - craneP * 45;
          posZ = 12.0 - craneP * 10.5;
          rotP = 35 - craneP * 35;
          vectorDesc = `Crane Swoop Down: Z=${posZ.toFixed(1)}m`;
          break;

        case 'spiral-corkscrew':
          const scAngle = activeProgress * 1.4;
          const scP = isComboMode ? p : tNorm;
          vfRotY = -Math.sin(scAngle) * 30;
          vfTransY = -40 * scP;
          rigTransX = Math.cos(scAngle) * 65;
          rigTransY = Math.sin(scAngle) * 65;
          rigTransZ = -45 * scP;
          posZ = 1.2 + 6.0 * scP;
          rotY = (scAngle * 180 / Math.PI) % 360;
          vectorDesc = `Spiral Ascending: Z=${posZ.toFixed(1)}m`;
          break;

        case 'fpv-drone-dive':
          const diveFactor = isComboMode ? p : tNorm;
          vfTransY = -120 + diveFactor * 160;
          vfScale = 0.6 + diveFactor * 1.8;
          vfRotX = 75 - diveFactor * 75;
          vfRotZ = Math.sin(activeProgress * 3.5) * 26 * (1 - diveFactor * 0.5);
          rotR = vfRotZ;
          rotP = vfRotX;
          posZ = 18.0 - diveFactor * 16.5;
          rigTransZ = 80 - diveFactor * 75;
          if (diveFactor > 0.25 && layerFxSpeed) {
            layerFxSpeed.style.opacity = `${(diveFactor - 0.25) * 1.8}`;
          }
          vectorDesc = `FPV Dive: Z=${posZ.toFixed(1)}m, Dive Speed: ${(diveFactor * 160).toFixed(0)}km/h`;
          break;

        case 'fly-through':
          const flyP = isComboMode ? p : tNorm;
          vfScale = 0.7 + flyP * 1.8;
          vfTransZ = -50 + flyP * 150;
          if (layerForegroundLeft && layerForegroundRight) {
            layerForegroundLeft.style.transform = `translateX(${-flyP * 150}px) scale(${1 + flyP})`;
            layerForegroundRight.style.transform = `translateX(${flyP * 150}px) scale(${1 + flyP})`;
          }
          vectorDesc = `Fly-Through Penetrating Portal`;
          break;

        // Special (8)
        case 'birds-eye':
          const beP = isComboMode ? p : tNorm;
          const beRot = beP * 45;
          vfRotX = 82;
          vfRotZ = beRot;
          vfTransY = -40 + beP * 15;
          vfScale = 0.75 + beP * 0.3;
          rotP = -90;
          rotR = beRot;
          posZ = 18.0 - beP * 6.0;
          rigTransY = 0;
          rigTransZ = 85 - beP * 25;
          rigRotZ = beRot;
          vectorDesc = `Birds-Eye: 90° Top-Down View (Z=${posZ.toFixed(1)}m, Rot: ${beRot.toFixed(0)}°)`;
          break;

        case 'worm-eye':
          const weBreath = Math.sin(activeProgress * 1.5);
          const weP = isComboMode ? p : tNorm;
          vfRotX = -45 + weBreath * 2;
          vfTransY = 55 - weP * 15;
          vfScale = 1.35 + 0.2 * weP + 0.05 * weBreath;
          rotP = 65;
          posZ = 0.15;
          rigTransY = 40;
          rigTransZ = -30;
          vectorDesc = `Worm-Eye: Ground Upward +65°`;
          break;

        case 'dutch-angle':
          const dutchP = isComboMode ? p : tNorm;
          const dutchFloat = Math.sin(activeProgress * 2) * 1.5;
          vfRotZ = 16 + 14 * dutchP + dutchFloat;
          rotR = vfRotZ;
          vfRotX = Math.cos(activeProgress * 1.5) * 2;
          vfScale = 1.05 + 0.08 * dutchP;
          vectorDesc = `Dutch Canted Tilt: ${rotR.toFixed(1)}° (Psychological Strain)`;
          break;

        case 'pov-shot':
          const povCadence = activeProgress * 4;
          vfTransX = Math.sin(povCadence) * 8;
          vfTransY = Math.abs(Math.sin(povCadence * 2)) * 6 - 3;
          vfRotZ = Math.sin(povCadence) * 3.5;
          vfRotX = Math.cos(povCadence) * 2;
          vfScale = 1.02 + 0.05 * Math.sin(povCadence * 2);
          vectorDesc = `First-Person POV Sprint (Footstep Cadence)`;
          break;

        case 'ots-shot':
          if (layerOtsShoulder) layerOtsShoulder.style.opacity = '1';
          const otsBreath = Math.sin(activeProgress * 1.6);
          const otsSway = Math.cos(activeProgress * 1.2);
          const otsP = isComboMode ? p : tNorm;
          vfRotY = -15 + otsSway * 1.5;
          rotY = vfRotY;
          vfTransX = 28 + otsSway * 2.5;
          vfTransY = otsBreath * 2;
          vfScale = 1.0 + 0.12 * otsP;
          if (layerOtsShoulder) {
            layerOtsShoulder.style.transform = `translateX(${-otsSway * 4}px) translateY(${otsBreath * 2}px)`;
          }
          vectorDesc = `Over-The-Shoulder Dialogue (Tension Push: +${(otsP * 100).toFixed(0)}%)`;
          break;

        case 'low-hero':
          const lhFloat = Math.sin(activeProgress * 1.8);
          vfRotX = -25 + lhFloat * 2;
          vfTransY = 25 - lhFloat * 3;
          vfScale = 1.25 + 0.05 * Math.cos(activeProgress * 1.5);
          rotP = 30;
          posZ = 0.6;
          subjectAnchor.style.boxShadow = '0 0 35px rgba(234, 179, 8, 0.4)';
          vectorDesc = `Low-Angle Hero Shot (King Aura)`;
          break;

        case 'bullet-time':
          const btAngle = activeProgress * 4;
          vfRotY = -Math.sin(btAngle) * 45;
          horizonOffset = Math.sin(btAngle) * 80;
          rigTransX = Math.cos(btAngle) * 85;
          rigTransY = Math.sin(btAngle) * 85;
          rigRotZ = (btAngle * 180 / Math.PI) - 90;
          rotY = (btAngle * 180 / Math.PI) % 360;
          vectorDesc = `Bullet Time: 360° Orbit (Frozen Action)`;
          break;

        case 'split-diopter':
          if (layerSplitLine) layerSplitLine.style.opacity = '1';
          if (layerForegroundLeft) {
            layerForegroundLeft.style.filter = 'blur(0px)';
          }
          subjectAnchor.style.filter = 'blur(0px)';
          horizonLayer.style.filter = 'blur(0px)';
          const diopterDrift = Math.sin(activeProgress * 1.5) * 5;
          const diopterP = isComboMode ? p : tNorm;
          vfTransX = -4 + diopterDrift;
          vfScale = 1.02 + 0.06 * diopterP;
          vectorDesc = `Split Diopter: Dual Sharp Planes (Optical Shift)`;
          break;

        default:
          vfTransX = 20 * t;
          vectorDesc = `Active Tracking`;
      }

      // Apply transformations to 3D Viewport
      viewfinderStage.style.transform = `rotateX(${vfRotX}deg) rotateY(${vfRotY}deg) rotateZ(${vfRotZ}deg) translate3d(${vfTransX}px, ${vfTransY}px, ${vfTransZ}px) scale(${vfScale})`;
      if (mId !== 'dolly-zoom') {
        horizonLayer.style.transform = `translateX(${horizonOffset}px)`;
      }

      // Apply transformations to God's Eye 3D Rig
      cameraRigMarker.style.transform = `translate3d(${rigTransX}px, ${rigTransY}px, ${rigTransZ}px) rotateZ(${rigRotZ}deg)`;

      // Update HUD Labels
      hudVectorText.textContent = vectorDesc;
      hudSubjectDist.textContent = `${(2.4 / (vfScale || 1)).toFixed(2)} m`;
      rigCoordText.textContent = `X: ${posX.toFixed(1)}m, Y: ${posY.toFixed(1)}m, Z: ${posZ.toFixed(1)}m`;
      rigRotText.textContent = `P: ${rotP.toFixed(0)}°, Y: ${rotY.toFixed(0)}°, R: ${rotR.toFixed(0)}°`;

      animFrameId = requestAnimationFrame(animateLoop);
    }

    // 6. Event Listeners for Combobox, Stepper, Hot Picks & Tabs
    comboboxSearchInput.addEventListener('focus', () => {
      openDropdown();
    });

    comboboxToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (comboboxDropdown.classList.contains('hidden')) {
        openDropdown();
      } else {
        closeDropdown();
      }
    });

    comboboxSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.trim();
      renderComboboxOptions(currentFilterCat, q);
      if (comboboxDropdown.classList.contains('hidden')) {
        comboboxDropdown.classList.remove('hidden');
        comboboxChevron.classList.add('rotate-180');
      }
    });

    comboboxSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        btnNextMovement.click();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        btnPrevMovement.click();
      }
    });

    // Close dropdown on click outside
    document.addEventListener('click', (e) => {
      if (comboboxWrapper && !comboboxWrapper.contains(e.target)) {
        if (!comboboxDropdown.classList.contains('hidden')) {
          closeDropdown();
        }
      }
    });

    // Stepper Navigation Buttons
    btnPrevMovement.addEventListener('click', () => {
      if (isComboMode) switchToSingleMode(false);
      const idx = MOVEMENTS_DATA.findIndex(m => m.id === currentMovement.id);
      const prevIdx = (idx - 1 + MOVEMENTS_DATA.length) % MOVEMENTS_DATA.length;
      selectMovement(MOVEMENTS_DATA[prevIdx]);
    });

    btnNextMovement.addEventListener('click', () => {
      if (isComboMode) switchToSingleMode(false);
      const idx = MOVEMENTS_DATA.findIndex(m => m.id === currentMovement.id);
      const nextIdx = (idx + 1) % MOVEMENTS_DATA.length;
      selectMovement(MOVEMENTS_DATA[nextIdx]);
    });

    btnRandomMovement.addEventListener('click', () => {
      if (isComboMode) switchToSingleMode(false);
      let randIdx;
      do {
        randIdx = Math.floor(Math.random() * MOVEMENTS_DATA.length);
      } while (MOVEMENTS_DATA[randIdx].id === currentMovement.id);
      selectMovement(MOVEMENTS_DATA[randIdx]);
    });

    // Hot Quick-Picks Buttons
    hotPickButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isComboMode) switchToSingleMode(false);
        const targetId = btn.dataset.pick;
        const targetMove = MOVEMENTS_DATA.find(m => m.id === targetId);
        if (targetMove) {
          selectMovement(targetMove);
        }
      });
    });

    // Dropdown Category Filter Chips
    combocatButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        combocatButtons.forEach(b => {
          b.classList.remove('bg-[#155EEF]', 'text-white', 'font-bold');
          b.classList.add('bg-slate-100', 'text-slate-600');
        });
        btn.classList.add('bg-[#155EEF]', 'text-white', 'font-bold');
        btn.classList.remove('bg-slate-100', 'text-slate-600');
        currentFilterCat = btn.dataset.combocat;
        renderComboboxOptions(currentFilterCat, comboboxSearchInput.value.trim());
      });
    });

    // Console Mode Switcher (Single vs Storyboard Combo)
    tabModeSingle.addEventListener('click', () => {
      switchToSingleMode();
    });

    tabModeCombo.addEventListener('click', () => {
      switchToComboMode(activeComboKey);
    });

    // Storyboard Preset Cards click handler
    comboCards.forEach(card => {
      card.addEventListener('click', () => {
        const comboKey = card.dataset.combo;
        switchToComboMode(comboKey);
      });
    });

    // Model Selector Tabs
    modelTabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        modelTabButtons.forEach(b => {
          b.classList.remove('bg-[#155EEF]', 'text-white', 'shadow-2xs');
          b.classList.add('text-slate-300');
        });
        btn.classList.add('bg-[#155EEF]', 'text-white', 'shadow-2xs');
        btn.classList.remove('text-slate-300');
        currentModel = btn.dataset.model;
        updateCompiledPrompt();
      });
    });

    focalSelect.addEventListener('change', updateCompiledPrompt);
    speedSelect.addEventListener('change', updateCompiledPrompt);
    customSubjectInput.addEventListener('input', updateCompiledPrompt);

    // Global Playback Controls
    const togglePlayBtn = document.getElementById('btn-toggle-play');
    const labelPlay = document.getElementById('label-play');
    const iconPause = document.getElementById('icon-pause');
    const iconPlay = document.getElementById('icon-play');
    togglePlayBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        labelPlay.textContent = '暫停動畫';
        iconPause.classList.remove('hidden');
        iconPlay.classList.add('hidden');
      } else {
        labelPlay.textContent = '播放動畫';
        iconPause.classList.add('hidden');
        iconPlay.classList.remove('hidden');
      }
    });

    const speedBtn = document.getElementById('btn-speed-toggle');
    const speedLabel = document.getElementById('label-speed');
    const speeds = [0.5, 1.0, 1.5, 2.0];
    let currentSpeedIdx = 1;
    speedBtn.addEventListener('click', () => {
      currentSpeedIdx = (currentSpeedIdx + 1) % speeds.length;
      animationSpeed = speeds[currentSpeedIdx];
      speedLabel.textContent = `${animationSpeed.toFixed(1)}x`;
    });

    const gridBtn = document.getElementById('btn-toggle-grid');
    const gridLabel = document.getElementById('label-grid');
    const gridOverlay = document.getElementById('rule-of-thirds-grid');
    gridBtn.addEventListener('click', () => {
      showGrid = !showGrid;
      if (showGrid) {
        gridOverlay.style.opacity = '1';
        gridLabel.textContent = '開';
        gridLabel.className = 'text-emerald-700 font-bold';
      } else {
        gridOverlay.style.opacity = '0';
        gridLabel.textContent = '關';
        gridLabel.className = 'text-slate-400 font-bold';
      }
    });

    const resetCamBtn = document.getElementById('btn-reset-cam');
    resetCamBtn.addEventListener('click', () => {
      if (isComboMode) {
        comboTime = 0;
      } else {
        selectMovement(currentMovement);
      }
    });

    // Copy Prompt Button
    copyBtn.addEventListener('click', async () => {
      const textToCopy = compiledOutput.textContent.trim();
      try {
        await navigator.clipboard.writeText(textToCopy);
        copyLabel.textContent = '✔ 已複製提示詞！';
        copyBtn.classList.add('from-emerald-600', 'to-teal-500');
        setTimeout(() => {
          copyLabel.textContent = '一鍵複製提示詞 (Copy)';
          copyBtn.classList.remove('from-emerald-600', 'to-teal-500');
        }, 2000);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });

    // Initial setup on load
    selectMovement(currentMovement);
    requestAnimationFrame(animateLoop);

  </script>

  <style>
    .clip-frustum {
      clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
    }
  </style>
</MainLayout>
