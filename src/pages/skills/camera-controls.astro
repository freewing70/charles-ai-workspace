      });
    }

    function openDropdown() {
      comboboxDropdown.classList.remove('hidden');
      comboboxChevron.classList.add('rotate-180');
      renderComboboxOptions(currentFilterCat, '');
      comboboxSearchInput.select();
    }

    function closeDropdown() {
      comboboxDropdown.classList.add('hidden');
      comboboxChevron.classList.remove('rotate-180');
      comboboxSearchInput.value = `${currentMovement.icon} ${currentMovement.zh} (${currentMovement.en}) · ${currentMovement.desc}`;
    }

    // 2. Select Movement Handler with clean resets
    function selectMovement(movement) {
      currentMovement = movement;
      animProgress = 0;
      hudMovementName.textContent = `${movement.en.toUpperCase()} (${movement.zh})`;

      // Clean reset of all visual modifiers
      resetVisualModifiers();

      // Update Combobox Display Input
      comboboxSearchInput.value = `${movement.icon} ${movement.zh} (${movement.en}) · ${movement.desc}`;
      comboboxLeadingIcon.textContent = movement.icon;
      const catInfo = CATEGORY_MAP[movement.cat];
      if (catInfo && comboboxActiveBadge) {
        comboboxActiveBadge.textContent = catInfo.name;
      }
      const curIdx = MOVEMENTS_DATA.findIndex(m => m.id === movement.id);
      movementCounterBadge.textContent = `${curIdx + 1} / ${MOVEMENTS_DATA.length}`;

      // Update Hot Quick-Picks Highlight
      hotPickButtons.forEach(btn => {
        if (btn.dataset.pick === movement.id) {
          btn.classList.add('bg-blue-50', 'border-blue-500', 'text-blue-700', 'font-bold');
          btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');
        } else {
          btn.classList.remove('bg-blue-50', 'border-blue-500', 'text-blue-700', 'font-bold');
          btn.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
        }
      });

      renderComboboxOptions(currentFilterCat, '');
      updateCompiledPrompt();
    }

    function resetVisualModifiers() {
      if (layerOtsShoulder) layerOtsShoulder.style.opacity = '0';
      if (layerFxSpeed) layerFxSpeed.style.opacity = '0';
      if (layerSplitLine) layerSplitLine.style.opacity = '0';
      if (layerForegroundLeft) layerForegroundLeft.style.transform = 'none';
      if (layerForegroundRight) layerForegroundRight.style.transform = 'none';
      if (subjectAnchor) {
        subjectAnchor.style.filter = 'none';
        subjectAnchor.style.boxShadow = 'none';
        subjectAnchor.style.opacity = '1';
        subjectAnchor.style.transform = 'none';
      }
      if (horizonLayer) {
        horizonLayer.style.filter = 'none';
        horizonLayer.style.transform = 'none';
      }
      if (viewfinderStage) {
        viewfinderStage.style.filter = 'none';
      }
    }

    function getCurrentFilterCat() {
      return currentFilterCat;
    }

    // 3. Update Compiled Prompt Generator (Handles Single & Combo Storyboard)
    function updateCompiledPrompt() {
      const focal = focalSelect.value;
      const speed = speedSelect.value;
      const subject = customSubjectInput.value.trim() || '一位主角站在場景中央';
      hudLensSpec.textContent = `${focal} · F/1.8`;

      let output = '';

      if (isComboMode) {
        const combo = STORYBOARD_COMBOS[activeComboKey];
        if (currentModel === 'kling') {
          modelBadge.textContent = '可靈 KLING AI 多鏡頭時序分鏡格式';
          output = `${combo.prompts.kling}, 主體: ${subject}, 焦距: ${focal}, 4k 畫質`;
        } else if (currentModel === 'runway') {
          modelBadge.textContent = 'RUNWAY MULTI-SHOT SEQUENCE 時序語法';
