        } else if (currentModel === 'luma') {
          modelBadge.textContent = 'LUMA DREAM MACHINE 多鏡頭分鏡格式';
          output = `${combo.prompts.luma} Subject: ${subject}, ${focal} lens, smooth cinematic motion.`;
        } else if (currentModel === 'sora') {
          modelBadge.textContent = 'OPENAI SORA 連續分鏡敘事語法';
          output = `${combo.prompts.sora} Featuring ${subject}. Filmed with a ${focal} cinema camera, photorealistic.`;
        } else if (currentModel === 'wan') {
          modelBadge.textContent = 'WAN / COMFYUI 鏈式分鏡節點權重格式';
          output = `${combo.prompts.wan}, (${focal} focal length:1.1), ${subject}, masterpiece, photorealistic 8k`;
        } else if (currentModel === 'seedance') {
          modelBadge.textContent = 'BYTEDANCE SEEDANCE 官方連貫時序分鏡格式';
          output = `${subject}. ${combo.prompts.seedance} Filmed with a ${focal} lens, speed: ${speed}, cinematic lighting.`;
        } else if (currentModel === 'minimax') {
          modelBadge.textContent = 'MINIMAX H3 (HAILUO AI) 官方時序分鏡語法';
          output = `${combo.prompts.minimax} The subject is ${subject}. Lens: ${focal}, speed: ${speed}, cinematic color grading, photorealistic 8k.`;
        }
      } else {
        if (currentModel === 'kling') {
          modelBadge.textContent = '可靈 KLING AI 官方格式';
          output = `${currentMovement.promptKling}, 焦距: ${focal}, 主體: ${subject}, 電影感光影, 4k 畫質`;
        } else if (currentModel === 'runway') {
          modelBadge.textContent = 'RUNWAY 官方提示詞';
          output = `${currentMovement.promptRunway}, speed: ${speed}, ${focal} cinematic lens, ${subject}, ultra-realistic 8k`;
        } else if (currentModel === 'luma') {
          modelBadge.textContent = 'LUMA DREAM MACHINE 格式';
          output = `${currentMovement.promptLuma}, ${focal} lens, ${subject}, high aesthetic cinematography, smooth motion`;
        } else if (currentModel === 'sora') {
          modelBadge.textContent = 'OPENAI SORA 自然語言格式';
          output = `${currentMovement.promptSora} Featuring ${subject}. Filmed with a ${focal} cinema camera, smooth photorealistic lighting.`;
        } else if (currentModel === 'wan') {
          modelBadge.textContent = 'WAN / COMFYUI 權重節點格式';
          output = `${currentMovement.promptWan}, (${focal} focal length:1.1), ${subject}, masterpiece, highly detailed, photorealistic`;
        } else if (currentModel === 'seedance') {
          modelBadge.textContent = 'BYTEDANCE SEEDANCE 官方結構化格式';
          output = `${subject}. ${currentMovement.promptSeedance || currentMovement.en}, filmed with a ${focal} focal length lens, speed: ${speed}, cinematic lighting, 4k resolution.`;
        } else if (currentModel === 'minimax') {
          modelBadge.textContent = 'MINIMAX H3 (HAILUO AI) 官方導演語法';
          output = `${currentMovement.promptMinimax || currentMovement.en} The subject is ${subject}. Lens: ${focal}, speed: ${speed}, cinematic color grading, photorealistic.`;
