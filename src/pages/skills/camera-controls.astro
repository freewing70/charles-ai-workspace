      { id: 'low-hero', cat: 'special', zh: '低角度英雄鏡頭', en: 'Low-Angle Hero Shot', icon: '👑', desc: '仰角搭配主體昂首挺胸，爽文短劇戰勝反派定格。', promptKling: '低視角英雄鏡頭, 仰角王者霸氣', promptRunway: 'Low-angle hero shot, majestic confident pose', promptLuma: 'Heroic low-angle framing with warm cinematic rim light', promptSora: 'Low-angle hero shot of the protagonist standing tall with authority...', promptWan: '(low-angle hero shot:1.3), triumphant posture' },
      { id: 'bullet-time', cat: 'special', zh: '子彈時間凝結', en: 'Bullet Time', icon: '⏳', desc: '時間放慢至幾乎靜止，相機繞行軌道飛馳，視覺奇觀。', promptKling: '子彈時間, 時間靜止環繞', promptRunway: 'Bullet time effect, frozen time with camera orbiting around', promptLuma: 'Bullet time camera freezing the raindrop in mid-air and orbiting', promptSora: 'Frozen time bullet time camera spinning around the suspended action...', promptWan: '(bullet time:1.4), frozen time camera pan' },
      { id: 'split-diopter', cat: 'special', zh: '雙焦透鏡分屏', en: 'Split Diopter', icon: '🌗', desc: '前景極近與後景極遠同時刀鋒般銳利，強烈戲劇衝突。', promptKling: '雙焦透鏡分屏, 前後景同時銳利清晰', promptRunway: 'Split diopter cinematography, extreme foreground and deep background both sharp', promptLuma: 'Split diopter lens with razor sharp foreground face and background door', promptSora: 'Split diopter composition with dual plane sharpness...', promptWan: '(split diopter:1.3), dual focus planes sharp' }
    ];

    // State Variables
    let currentMovement = MOVEMENTS_DATA[0]; // default 'pan-left'
    let currentModel = 'kling';
    let isPlaying = true;
    let animationSpeed = 1.0;
    let showGrid = true;
    let animFrameId = null;
    let animProgress = 0;

    // DOM Elements
    const viewfinderStage = document.getElementById('viewfinder-stage');
    const horizonLayer = document.getElementById('layer-horizon');
    const subjectAnchor = document.getElementById('subject-anchor');
    const cameraRigMarker = document.getElementById('camera-rig-marker');
    const layerOtsShoulder = document.getElementById('layer-ots-shoulder');
    const layerFxSpeed = document.getElementById('layer-fx-speed');
    const layerSplitLine = document.getElementById('layer-split-line');
    const layerForegroundLeft = document.getElementById('layer-foreground-left');
    const layerForegroundRight = document.getElementById('layer-foreground-right');
    const hudMovementName = document.getElementById('hud-movement-name');
    const hudVectorText = document.getElementById('hud-vector-text');
    const hudLensSpec = document.getElementById('hud-lens-spec');
    const hudSubjectDist = document.getElementById('hud-subject-distance');
    const rigCoordText = document.getElementById('rig-coord-text');
    const rigRotText = document.getElementById('rig-rot-text');
    const compiledOutput = document.getElementById('compiled-prompt-output');
    const modelBadge = document.getElementById('prompt-model-badge');
    const chipsContainer = document.getElementById('movement-chips-container');
    const searchInput = document.getElementById('movement-search-input');
    const catButtons = document.querySelectorAll('.cat-btn');
    const modelTabButtons = document.querySelectorAll('.model-tab-btn');
    const focalSelect = document.getElementById('select-focal-length');
    const speedSelect = document.getElementById('select-motion-speed');
    const customSubjectInput = document.getElementById('input-custom-subject');
    const copyBtn = document.getElementById('btn-copy-prompt');
    const copyLabel = document.getElementById('copy-btn-label');

    // 1. Initialize Movement Chips
    function renderChips(filterCat = 'all', searchQuery = '') {
      chipsContainer.innerHTML = '';
      const filtered = MOVEMENTS_DATA.filter(item => {
        const matchesCat = filterCat === 'all' || item.cat === filterCat;
        const matchesSearch = !searchQuery || item.zh.includes(searchQuery) || item.en.toLowerCase().includes(searchQuery.toLowerCase()) || item.desc.includes(searchQuery);
        return matchesCat && matchesSearch;
      });

      filtered.forEach(item => {
        const isSelected = item.id === currentMovement.id;
        const btn = document.createElement('button');
        btn.className = `p-2.5 rounded-xl border text-left transition-all cursor-pointer flex flex-col justify-between ${
          isSelected 
            ? 'bg-blue-50 border-blue-500 text-[#155EEF] ring-2 ring-blue-500/20 shadow-xs' 
            : 'bg-white hover:bg-slate-50 border-slate-200 text-[#07172D]'
        }`;
        btn.innerHTML = `
          <div class="flex items-center justify-between gap-1 w-full">
            <span class="text-xs font-bold truncate">${item.zh}</span>
            <span class="text-xs font-mono opacity-60">${item.icon}</span>
          </div>
          <span class="text-[10px] font-mono text-slate-400 truncate mt-1">${item.en}</span>
        `;
        btn.addEventListener('click', () => {
          selectMovement(item);
        });
        chipsContainer.appendChild(btn);
      });
    }

    // 2. Select Movement Handler with clean resets
    function selectMovement(movement) {
      currentMovement = movement;
      animProgress = 0;
      hudMovementName.textContent = `${movement.en.toUpperCase()} (${movement.zh})`;

      // Clean reset of all visual modifiers
      if (layerOtsShoulder) layerOtsShoulder.style.opacity = '0';
      if (layerFxSpeed) layerFxSpeed.style.opacity = '0';
      if (layerSplitLine) layerSplitLine.style.opacity = '0';
      if (layerForegroundLeft) layerForegroundLeft.style.transform = 'none';
      if (layerForegroundRight) layerForegroundRight.style.transform = 'none';
      if (subjectAnchor) {
        subjectAnchor.style.filter = 'none';
        subjectAnchor.style.boxShadow = 'none';
        subjectAnchor.style.opacity = '1';
        subjectAnchor.style.transform = 'none';
      }
      if (horizonLayer) {
        horizonLayer.style.filter = 'none';
        horizonLayer.style.transform = 'none';
      }
      if (viewfinderStage) {
        viewfinderStage.style.filter = 'none';
      }

      renderChips(getCurrentFilterCat(), searchInput.value.trim());
      updateCompiledPrompt();
    }

    function getCurrentFilterCat() {
      const activeBtn = document.querySelector('.cat-btn.bg-\\[\\#155EEF\\]');
      return activeBtn ? activeBtn.dataset.cat : 'all';
    }

    // 3. Update Compiled Prompt Generator
    function updateCompiledPrompt() {
      const focal = focalSelect.value;
      const speed = speedSelect.value;
      const subject = customSubjectInput.value.trim() || '一位主角站在場景中央';
      hudLensSpec.textContent = `${focal} · F/1.8`;

      let output = '';
      if (currentModel === 'kling') {
        modelBadge.textContent = '可靈 KLING AI 官方格式';
        output = `${currentMovement.promptKling}, 焦距: ${focal}, 主體: ${subject}, 電影感光影, 4k 畫質`;
      } else if (currentModel === 'runway') {
        modelBadge.textContent = 'RUNWAY GEN-3 / GEN-4 提示詞';
        output = `${currentMovement.promptRunway}, speed: ${speed}, ${focal} cinematic lens, ${subject}, ultra-realistic 8k`;
      } else if (currentModel === 'luma') {
        modelBadge.textContent = 'LUMA DREAM MACHINE 格式';
        output = `${currentMovement.promptLuma}, ${focal} lens, ${subject}, high aesthetic cinematography, smooth motion`;
      } else if (currentModel === 'sora') {
        modelBadge.textContent = 'OPENAI SORA 自然語言格式';
        output = `${currentMovement.promptSora} Featuring ${subject}. Filmed with a ${focal} cinema camera, smooth photorealistic lighting.`;
      } else if (currentModel === 'wan') {
        modelBadge.textContent = 'WAN 2.1 / COMFYUI 權重節點格式';
        output = `${currentMovement.promptWan}, (${focal} focal length:1.1), ${subject}, masterpiece, highly detailed, photorealistic`;
      }

      compiledOutput.textContent = output;
    }

    // 4. Animation Loop for 3D Viewport Physics (ALL 40 MOVEMENTS FULLY IMPLEMENTED)
    function animateLoop() {
      if (isPlaying) {
        animProgress += 0.025 * animationSpeed;
      }
      
      const t = Math.sin(animProgress); // -1 to 1 oscillation
      const tNorm = (t + 1) / 2; // 0 to 1 smooth oscillation
      const mId = currentMovement.id;

      let vfRotX = 0, vfRotY = 0, vfRotZ = 0, vfTransX = 0, vfTransY = 0, vfTransZ = 0, vfScale = 1;
      let rigTransX = 0, rigTransY = 85, rigTransZ = 0, rigRotZ = 0;
      let horizonOffset = 0;

      // Coordinate HUD outputs
      let posX = 0, posY = -2.4, posZ = 1.2;
      let rotP = 0, rotY = 0, rotR = 0;
      let vectorDesc = '';

      switch (mId) {
        // === CATEGORY 1: PHYSICAL TRANSLATIONS & ROTATIONS (12) ===
        case 'pan-left':
          vfRotY = -25 * t;
          vfTransX = 80 * t;
          horizonOffset = -70 * t;
          rigRotZ = -35 * t;
          rotY = -25 * t;
          vectorDesc = `Yaw: ${rotY.toFixed(1)}° (Pan L)`;
          break;
        case 'pan-right':
          vfRotY = 25 * t;
          vfTransX = -80 * t;
          horizonOffset = 70 * t;
          rigRotZ = 35 * t;
          rotY = 25 * t;
          vectorDesc = `Yaw: +${rotY.toFixed(1)}° (Pan R)`;
          break;
        case 'tilt-up':
          vfRotX = 26 * t;
          vfTransY = 65 * t;
          rotP = 26 * t;
          vectorDesc = `Pitch: +${rotP.toFixed(1)}° (Tilt Up)`;
          break;
        case 'tilt-down':
          vfRotX = -26 * t;
          vfTransY = -65 * t;
          rotP = -26 * t;
          vectorDesc = `Pitch: ${rotP.toFixed(1)}° (Tilt Down)`;
          break;
        case 'roll-cw':
          vfRotZ = 22 * t;
          rotR = 22 * t;
          vectorDesc = `Roll: +${rotR.toFixed(1)}° (CW)`;
          break;
        case 'roll-ccw':
          vfRotZ = -22 * t;
          rotR = -22 * t;
          vectorDesc = `Roll: ${rotR.toFixed(1)}° (CCW)`;
          break;
        case 'dolly-in':
          vfScale = 1 + 0.45 * tNorm;
          vfTransZ = 110 * tNorm;
          rigTransY = 85 - 50 * tNorm;
          posY = -2.4 + 1.2 * tNorm;
          vectorDesc = `Dolly In: +${(1.2 * tNorm).toFixed(2)}m`;
          break;
        case 'dolly-out':
          vfScale = 1.4 - 0.45 * tNorm;
          vfTransZ = 110 * (1 - tNorm);
          rigTransY = 35 + 50 * tNorm;
          posY = -1.2 - 1.2 * tNorm;
          vectorDesc = `Dolly Out: -${(1.2 * tNorm).toFixed(2)}m`;
          break;
        case 'truck-left':
          vfTransX = 90 * t;
          rigTransX = -50 * t;
          horizonOffset = 35 * t;
          posX = -1.5 * t;
          vectorDesc = `Truck L: ${(posX).toFixed(2)}m`;
          break;
        case 'truck-right':
          vfTransX = -90 * t;
          rigTransX = 50 * t;
          horizonOffset = -35 * t;
          posX = 1.5 * t;
          vectorDesc = `Truck R: +${(posX).toFixed(2)}m`;
          break;
        case 'pedestal-up':
          vfTransY = 70 * tNorm;
          rigTransZ = 45 * tNorm;
          posZ = 1.2 + 1.5 * tNorm;
          vectorDesc = `Pedestal Up: +${(1.5 * tNorm).toFixed(2)}m`;
          break;
        case 'pedestal-down':
          vfTransY = -70 * tNorm;
          rigTransZ = -35 * tNorm;
          posZ = 1.2 - 1.0 * tNorm;
          vectorDesc = `Pedestal Down: -${(1.0 * tNorm).toFixed(2)}m`;
          break;

        // === CATEGORY 2: OPTICAL & DEPTH OF FIELD (6) ===
        case 'zoom-in':
          vfScale = 1 + 0.65 * tNorm;
          vectorDesc = `Optical Zoom: ${(35 + 55 * tNorm).toFixed(0)}mm`;
          break;
        case 'zoom-out':
          vfScale = 1.65 - 0.65 * tNorm;
          vectorDesc = `Optical Zoom: ${(90 - 55 * tNorm).toFixed(0)}mm`;
          break;
        case 'crash-zoom':
          const crashFactor = Math.pow(tNorm, 4);
          vfScale = 1 + 1.1 * crashFactor;
          if (crashFactor > 0.4 && layerFxSpeed) {
            layerFxSpeed.style.opacity = '0.6';
          }
          vectorDesc = `Crash Zoom Snap: ${(35 + 85 * crashFactor).toFixed(0)}mm`;
          break;
        case 'rack-focus':
          // Smooth focus shifting between foreground and background
          if (t > 0) {
            horizonLayer.style.filter = `blur(${(t * 8).toFixed(1)}px)`;
            subjectAnchor.style.filter = 'none';
            vectorDesc = `Focus: Subject Sharp (Foreground)`;
          } else {
            horizonLayer.style.filter = 'none';
            subjectAnchor.style.filter = `blur(${(-t * 6).toFixed(1)}px)`;
            vectorDesc = `Focus: Background Sharp`;
          }
          break;
        case 'deep-focus':
          vfScale = 1;
          horizonLayer.style.filter = 'none';
          subjectAnchor.style.filter = 'none';
          vectorDesc = `Deep Focus: F/11 Razor Sharp`;
          break;
        case 'shallow-dof':
          vfScale = 1.05;
          horizonLayer.style.filter = 'blur(10px)';
          subjectAnchor.style.filter = 'none';
          subjectAnchor.style.boxShadow = '0 0 20px rgba(0, 242, 254, 0.35)';
          vectorDesc = `Shallow DOF: F/1.4 Creamy Bokeh`;
          break;

        // === CATEGORY 3: COMPOUND & KINETIC TRAJECTORIES (14) ===
        case 'orbit-360':
          const angleRad = animProgress;
          const radius = 85;
          rigTransX = Math.sin(angleRad) * radius;
          rigTransY = Math.cos(angleRad) * radius;
          rigRotZ = -angleRad * 57.3;
          vfRotY = -angleRad * 35;
          horizonOffset = (-angleRad * 45) % 240;
          rotY = (angleRad * 57.3) % 360;
          vectorDesc = `Orbit 360°: ${rotY.toFixed(0)}°`;
          break;
        case 'arc-left':
          const arcL = tNorm * 1.57; // 0 to 90 deg
          rigTransX = -Math.sin(arcL) * 85;
          rigTransY = Math.cos(arcL) * 85;
          rigRotZ = -arcL * 57.3;
          vfRotY = -arcL * 35;
          vfTransX = arcL * 45;
          rotY = -arcL * 57.3;
          vectorDesc = `Arc Left: ${(arcL * 57.3).toFixed(0)}° (90° Arc)`;
          break;
        case 'arc-right':
          const arcR = tNorm * 1.57;
          rigTransX = Math.sin(arcR) * 85;
          rigTransY = Math.cos(arcR) * 85;
          rigRotZ = arcR * 57.3;
          vfRotY = arcR * 35;
          vfTransX = -arcR * 45;
          rotY = arcR * 57.3;
          vectorDesc = `Arc Right: +${(arcR * 57.3).toFixed(0)}° (90° Arc)`;
          break;
        case 'lead-tracking':
          // Camera moving backward leading the walking actor
          const walkBob = Math.abs(Math.sin(animProgress * 3.5)) * 8 - 4;
          vfTransY = walkBob;
          vfScale = 1.15 - 0.25 * tNorm;
          rigTransY = 55 + 35 * tNorm;
          posY = -1.8 - 0.8 * tNorm;
          vectorDesc = `Lead Tracking: ${(posY).toFixed(1)}m (Walk Cadence)`;
          break;
        case 'trail-tracking':
          // Camera following behind
          const runBob = Math.abs(Math.sin(animProgress * 4.5)) * 10 - 5;
          vfTransY = runBob;
          vfScale = 0.95 + 0.3 * tNorm;
          rigTransY = 95 - 35 * tNorm;
          posY = -2.8 + 0.8 * tNorm;
          vectorDesc = `Trail Pursuit: ${(posY).toFixed(1)}m (Chase)`;
          break;
        case 'side-tracking':
          // Lateral track alongside
          vfTransX = Math.sin(animProgress * 1.5) * 65;
          horizonOffset = Math.cos(animProgress * 1.5) * 85;
          rigTransX = -Math.sin(animProgress * 1.5) * 55;
          vectorDesc = `Side Track Velocity: 4.5 m/s`;
          break;
        case 'dolly-zoom':
          // Vertigo effect: subject stays constant, horizon warps
          vfScale = 1;
          const vertigoDistort = 1.8 * tNorm;
          horizonLayer.style.transform = `scale(${1 + vertigoDistort}) translateY(${-25 * vertigoDistort}px)`;
          rigTransY = 85 - 55 * tNorm;
          vectorDesc = `Vertigo Warp: ${(vertigoDistort * 100).toFixed(0)}% (Hitchcock)`;
          break;
        case 'whip-pan':
          // Ultra fast lateral wipe with blur
          const snapPan = Math.sin(animProgress * 3.2);
          vfRotY = snapPan * 65;
          horizonOffset = -snapPan * 95;
          if (Math.abs(snapPan) > 0.4) {
            viewfinderStage.style.filter = 'blur(10px)';
            if (layerFxSpeed) layerFxSpeed.style.opacity = '0.7';
          } else {
            viewfinderStage.style.filter = 'none';
            if (layerFxSpeed) layerFxSpeed.style.opacity = '0';
          }
          vectorDesc = `Whip Pan Kinetic: ${(Math.abs(snapPan) * 450).toFixed(0)}°/s`;
          break;
        case 'handheld-shaky':
          vfRotX = (Math.sin(animProgress * 2.8) * 3 + Math.cos(animProgress * 4.1) * 2);
          vfRotY = (Math.cos(animProgress * 2.3) * 3.5 + Math.sin(animProgress * 5.2) * 1.5);
          vfRotZ = (Math.sin(animProgress * 1.9) * 2.2);
          vfTransX = (Math.cos(animProgress * 3.1) * 8);
          vfTransY = (Math.sin(animProgress * 3.7) * 7);
          vectorDesc = `Organic Handheld Shaky Cam`;
          break;
        case 'steadicam':
          // Smooth 3-axis floating motion
          vfTransX = Math.sin(animProgress * 0.9) * 25;
          vfTransY = Math.cos(animProgress * 1.3) * 15;
          vfRotZ = Math.sin(animProgress * 0.7) * 3;
          vfScale = 1.05 + Math.sin(animProgress * 0.8) * 0.1;
          rigTransX = Math.sin(animProgress * 0.9) * 20;
          rigTransY = 85 + Math.cos(animProgress * 1.3) * 15;
          vectorDesc = `Steadicam 3-Axis Gyro Glide`;
          break;
        case 'crane-shot':
          // Sweeping descent from 5m down to eye-level close-up
          vfRotX = -32 * (1 - tNorm);
          vfTransY = -75 * (1 - tNorm);
          vfScale = 0.75 + 0.65 * tNorm;
          rigTransZ = 65 * (1 - tNorm);
          rigTransY = 115 - 55 * tNorm;
          posZ = 1.2 + 3.8 * (1 - tNorm);
          rotP = -32 * (1 - tNorm);
          vectorDesc = `Crane Swoop: Alt ${(posZ).toFixed(1)}m ↓`;
          break;
        case 'spiral-corkscrew':
          // Spin 360 AND ascend vertically
          const corkSpin = animProgress * 1.2;
          const corkZ = (animProgress * 18) % 65;
          rigTransX = Math.sin(corkSpin) * 75;
          rigTransY = Math.cos(corkSpin) * 75;
          rigTransZ = corkZ;
          rigRotZ = -corkSpin * 57.3;
          vfRotY = -corkSpin * 32;
          vfTransY = 40 - ((animProgress * 25) % 80);
          posZ = 1.2 + corkZ * 0.05;
          vectorDesc = `Spiral Ascent: Alt ${(posZ).toFixed(1)}m ↻`;
          break;
        case 'fpv-drone-dive':
          // REAL FPV VERTICAL DIVE SIMULATION
          const diveCycle = (animProgress * 0.9) % (Math.PI * 2);
          const divePower = (Math.sin(diveCycle) + 1) / 2; // 0 to 1
          // Camera banks and plunges straight down
          vfRotX = -55 * (1 - divePower) + 15 * divePower; // steep downward tilt then pull-up
          vfRotZ = Math.sin(diveCycle * 1.5) * 32; // rolling aerobatic bank
          vfTransY = -120 * (1 - divePower) + 40 * divePower; // plunging down
          vfScale = 0.6 + 1.8 * Math.pow(divePower, 2); // zooming in at extreme speed
          // Speed lines activate during dive
          if (layerFxSpeed) {
            layerFxSpeed.style.opacity = divePower > 0.35 ? '0.85' : '0';
          }
          // Rig drops from top of coordinates
          rigTransZ = 80 * (1 - divePower) + 5 * divePower;
          rigTransY = 120 - 75 * divePower;
          rigRotZ = vfRotZ;
          posZ = 18.0 - 16.5 * divePower;
          vectorDesc = `FPV Dive: ${(posZ).toFixed(1)}m | ${(55 + 65 * divePower).toFixed(0)} km/h ↓`;
          break;
        case 'fly-through':
          // Accelerate through obstacles and past subject
          const flyCycle = (animProgress * 0.8) % (Math.PI * 2);
          const flyT = (Math.sin(flyCycle) + 1) / 2;
          vfScale = 0.6 + 2.4 * Math.pow(flyT, 1.8);
          // Foreground pillars push out wide as we pass through
          if (layerForegroundLeft) layerForegroundLeft.style.transform = `scale(${1 + 2.5 * flyT}) translateX(${-140 * flyT}px)`;
          if (layerForegroundRight) layerForegroundRight.style.transform = `scale(${1 + 2.5 * flyT}) translateX(${140 * flyT}px)`;
          if (subjectAnchor) {
            subjectAnchor.style.opacity = flyT > 0.85 ? '0.1' : '1';
          }
          rigTransY = 110 - 95 * flyT;
          posY = -3.2 + 2.8 * flyT;
          vectorDesc = `Fly-Through Depth: ${(posY).toFixed(1)}m`;
          break;

        // === CATEGORY 4: SPECIAL ANGLES & POVS (8) ===
        case 'birds-eye':
          // 90° straight Top-Down
          vfRotX = 82; // Look down at top of head
          vfScale = 1.1;
          rigTransX = 0;
          rigTransY = 0;
          rigTransZ = 85;
          rotP = -90;
          vectorDesc = `90° Birds-Eye Top-Down Nadir`;
          break;
        case 'worm-eye':
          // Ground level upward looking up
          vfRotX = -45;
          vfTransY = -45;
          vfScale = 1.45;
          rigTransY = 45;
          rigTransZ = -20;
          rotP = 65;
          posZ = 0.1;
          vectorDesc = `Worm-Eye Ground Level (+65°)`;
          break;
        case 'dutch-angle':
          // Permanent canted angle with slight tense breathe
          vfRotZ = 24 + Math.sin(animProgress * 1.5) * 4;
          rotR = vfRotZ;
          vectorDesc = `Dutch Canted Angle: ${rotR.toFixed(1)}°`;
          break;
        case 'pov-shot':
          // First person footsteps and gaze
          const stepBounce = Math.abs(Math.sin(animProgress * 4.2)) * 12 - 6;
          vfTransY = stepBounce;
          vfTransX = Math.sin(animProgress * 2.1) * 9;
          vfRotZ = Math.sin(animProgress * 2.1) * 2;
          vfRotY = Math.sin(animProgress * 0.9) * 12;
          vectorDesc = `POV First-Person Human Stride`;
          break;
        case 'ots-shot':
          // Over-the-shoulder framing
          if (layerOtsShoulder) layerOtsShoulder.style.opacity = '0.95';
          vfTransX = 45;
          vfRotY = -14;
          vfScale = 1.15;
          rotY = -14;
          vectorDesc = `Over-the-Shoulder Dialogue OTS`;
          break;
        case 'low-hero':
          // Triumphant heroic low angle
          vfRotX = -26;
          vfScale = 1.35;
          vfTransY = -30;
          vfTransX = Math.sin(animProgress * 0.7) * 20;
          rotP = 26;
          vectorDesc = `Low-Angle Heroic Triumph (+26°)`;
          break;
        case 'bullet-time':
          // Action freezes, camera circles at extreme speed
          const btAngle = animProgress * 3.0;
          rigTransX = Math.sin(btAngle) * 85;
          rigTransY = Math.cos(btAngle) * 85;
          rigRotZ = -btAngle * 57.3;
          vfRotY = -btAngle * 35;
          horizonOffset = (-btAngle * 45) % 240;
          if (layerFxSpeed) layerFxSpeed.style.opacity = '0.4';
          vectorDesc = `Bullet Time Orbit: ${(btAngle * 57.3 % 360).toFixed(0)}° (Frozen)`;
          break;
        case 'split-diopter':
          // Split optical line active
          if (layerSplitLine) layerSplitLine.style.opacity = '0.9';
          vfScale = 1.05;
          vectorDesc = `Split Diopter Dual Focus Planes`;
          break;

        default:
          vfTransX = 20 * t;
          vectorDesc = `Active Tracking`;
      }

      // Apply transformations to 3D Viewport
      viewfinderStage.style.transform = `rotateX(${vfRotX}deg) rotateY(${vfRotY}deg) rotateZ(${vfRotZ}deg) translate3d(${vfTransX}px, ${vfTransY}px, ${vfTransZ}px) scale(${vfScale})`;
      if (mId !== 'dolly-zoom') {
        horizonLayer.style.transform = `translateX(${horizonOffset}px)`;
      }

      // Apply transformations to God's Eye 3D Rig
      cameraRigMarker.style.transform = `translate3d(${rigTransX}px, ${rigTransY}px, ${rigTransZ}px) rotateZ(${rigRotZ}deg)`;

      // Update HUD Labels
      hudVectorText.textContent = vectorDesc;
      hudSubjectDist.textContent = `${(2.4 / (vfScale || 1)).toFixed(2)} m`;
      rigCoordText.textContent = `X: ${posX.toFixed(1)}m, Y: ${posY.toFixed(1)}m, Z: ${posZ.toFixed(1)}m`;
      rigRotText.textContent = `P: ${rotP.toFixed(0)}°, Y: ${rotY.toFixed(0)}°, R: ${rotR.toFixed(0)}°`;

      animFrameId = requestAnimationFrame(animateLoop);
    }


    // Event Listeners for Filters, Search & Tabs
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('bg-[#155EEF]', 'text-white', 'shadow-2xs');
          b.classList.add('bg-slate-100', 'text-slate-600');
        });
        btn.classList.add('bg-[#155EEF]', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-slate-100', 'text-slate-600');
        renderChips(btn.dataset.cat, searchInput.value.trim());
      });
    });

    searchInput.addEventListener('input', (e) => {
      renderChips(getCurrentFilterCat(), e.target.value.trim());
    });

    modelTabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        modelTabButtons.forEach(b => {
          b.classList.remove('bg-[#155EEF]', 'text-white', 'shadow-2xs');
          b.classList.add('text-slate-300');
        });
        btn.classList.add('bg-[#155EEF]', 'text-white', 'shadow-2xs');
        btn.classList.remove('text-slate-300');
        currentModel = btn.dataset.model;
        updateCompiledPrompt();
      });
    });

    focalSelect.addEventListener('change', updateCompiledPrompt);
    speedSelect.addEventListener('change', updateCompiledPrompt);
    customSubjectInput.addEventListener('input', updateCompiledPrompt);

    // Playback Controls
    const btnPlay = document.getElementById('btn-toggle-play');
    const labelPlay = document.getElementById('label-play');
    const iconPause = document.getElementById('icon-pause');
    const iconPlay = document.getElementById('icon-play');

    btnPlay.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        labelPlay.textContent = '暫停動畫';
        iconPause.classList.remove('hidden');
        iconPlay.classList.add('hidden');
      } else {
        labelPlay.textContent = '播放動畫';
        iconPause.classList.add('hidden');
        iconPlay.classList.remove('hidden');
      }
    });

    const btnSpeed = document.getElementById('btn-speed-toggle');
    const labelSpeed = document.getElementById('label-speed');
    btnSpeed.addEventListener('click', () => {
      if (animationSpeed === 1.0) {
        animationSpeed = 2.0;
        labelSpeed.textContent = '2.0x (快)';
      } else if (animationSpeed === 2.0) {
        animationSpeed = 0.5;
        labelSpeed.textContent = '0.5x (慢)';
      } else {
        animationSpeed = 1.0;
        labelSpeed.textContent = '1.0x (標準)';
      }
    });

    const btnGrid = document.getElementById('btn-toggle-grid');
    const labelGrid = document.getElementById('label-grid');
    const gridOverlay = document.getElementById('rule-of-thirds-grid');
    btnGrid.addEventListener('click', () => {
      showGrid = !showGrid;
      if (showGrid) {
        labelGrid.textContent = '開';
        labelGrid.className = 'text-emerald-700 font-bold';
        gridOverlay.style.opacity = '1';
      } else {
        labelGrid.textContent = '關';
        labelGrid.className = 'text-slate-400 font-bold';
        gridOverlay.style.opacity = '0';
      }
    });

    const btnResetCam = document.getElementById('btn-reset-cam');
    btnResetCam.addEventListener('click', () => {
      animProgress = 0;
      selectMovement(MOVEMENTS_DATA[0]);
    });

    // Copy Prompt Button
    copyBtn.addEventListener('click', async () => {
      const textToCopy = compiledOutput.textContent.trim();
      try {
        await navigator.clipboard.writeText(textToCopy);
        copyLabel.textContent = '✔ 已複製提示詞！';
        copyBtn.classList.add('from-emerald-600', 'to-teal-500');
        setTimeout(() => {
          copyLabel.textContent = '一鍵複製提示詞 (Copy)';
          copyBtn.classList.remove('from-emerald-600', 'to-teal-500');
        }, 2000);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });

    // Preset Combo Buttons
    const comboMap = {
      hero: 'tilt-up',
      vertigo: 'dolly-zoom',
      chase: 'fpv-drone-dive',
      drama: 'rack-focus',
      epic: 'birds-eye'
    };

    document.querySelectorAll('.btn-apply-combo').forEach(btn => {
      btn.addEventListener('click', () => {
        const comboKey = btn.dataset.combo;
        const targetMovementId = comboMap[comboKey];
        const match = MOVEMENTS_DATA.find(m => m.id === targetMovementId);
        if (match) {
          selectMovement(match);
          window.scrollTo({ top: 380, behavior: 'smooth' });
        }
      });
    });

    // Initial setup on load
    renderChips();
    updateCompiledPrompt();
    requestAnimationFrame(animateLoop);
  </script>

  <style>
    .clip-frustum {
      clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
    }
  </style>
</MainLayout>
