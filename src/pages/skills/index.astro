---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getItemsByType } from '../../lib/content';

const skills = getItemsByType('skill', false);
const allTags = Array.from(new Set(skills.flatMap(s => s.meta.tags)));
---

<MainLayout title="AI Skills 技能目錄">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <SectionHeader
      eyebrow="LEARN"
      title="AI Skills 技能目錄"
      description="標準化封裝的 AI 提示詞技能模組，包含完整參數定義、系統指令、多維度範例與跨平台使用指南。"
      badge={`${skills.length} 項模組`}
    />

    <!-- Tags Filter Row -->
    {allTags.length > 0 && (
      <div class="mb-10 p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-500 font-semibold mr-2">熱門標籤:</span>
        {allTags.map(tag => (
          <a
            href={`/search?q=${encodeURIComponent(tag)}`}
            class="text-xs px-3 py-1 rounded-lg bg-white hover:bg-blue-50 text-slate-700 hover:text-[#155EEF] border border-slate-200 hover:border-blue-200 transition-colors shadow-2xs font-mono"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <!-- Skills Grid -->
    {skills.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {skills.map((item) => (
          <ContentCard item={item.meta} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-slate-50 rounded-2xl border border-slate-200">
        <p class="text-slate-500">目前尚無公開 Skill。</p>
      </div>
    )}
  </div>
</MainLayout>
