---
import MainLayout from '../../layouts/MainLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getItemsByType } from '../../lib/content';

const skills = getItemsByType('skill', false);
const allCategories = Array.from(new Set(skills.map(s => s.meta.category)));
const allTags = Array.from(new Set(skills.flatMap(s => s.meta.tags)));
---

<MainLayout title="Skills 技能庫">
  <div class="mb-10">
    <div class="flex items-center gap-2 text-sm text-indigo-400 font-mono mb-2">
      <span>/skills</span>
      <span>&bull;</span>
      <span>{skills.length} 項技能</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">AI Skills 技能目錄</h1>
    <p class="mt-2 text-gray-400 max-w-2xl">
      標準化封裝的 AI 提示詞技能模組，包含詳細用途說明、系統指令、多維度範例與跨平台使用指南。
    </p>
  </div>

  <!-- Tags / Filter Chips -->
  {allTags.length > 0 && (
    <div class="mb-8 p-4 rounded-xl bg-gray-900/60 border border-gray-800 flex flex-wrap items-center gap-2">
      <span class="text-xs text-gray-400 font-mono mr-2">熱門標籤:</span>
      {allTags.map(tag => (
        <a
          href={`/search?q=${encodeURIComponent(tag)}`}
          class="text-xs px-2.5 py-1 rounded-lg bg-gray-800 hover:bg-indigo-600/30 text-gray-300 hover:text-indigo-300 border border-gray-700/60 transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}

  <!-- Grid -->
  {skills.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skills.map((item) => (
        <ContentCard item={item.meta} />
      ))}
    </div>
  ) : (
    <div class="text-center py-20 bg-gray-900/40 rounded-2xl border border-gray-800">
      <p class="text-gray-400">目前尚無公開 Skill，請透過新增工作流添加內容。</p>
    </div>
  )}
</MainLayout>
