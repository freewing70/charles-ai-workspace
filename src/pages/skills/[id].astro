---
import MainLayout from '../../layouts/MainLayout.astro';
import { getAllItems, getItemById } from '../../lib/content';
import { getAssetUrl, getContentRoute } from '../../lib/assets';
import { marked } from 'marked';

export function getStaticPaths() {
  const items = getAllItems(false).filter(i => i.meta.type === 'skill');
  return items.map((item) => ({
    params: { id: item.meta.id },
  }));
}

const { id } = Astro.params;
const item = getItemById(id, false);

if (!item) {
  return Astro.redirect('/404');
}

const htmlContent = marked.parse(item.content);
const coverUrl = getAssetUrl(item.meta.cover);
---

<MainLayout title={item.meta.title} description={item.meta.summary} image={coverUrl}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono mb-8">
      <a href="/" class="hover:text-[#155EEF] transition-colors">首頁</a>
      <span>/</span>
      <a href="/skills" class="hover:text-[#155EEF] transition-colors">Skills</a>
      <span>/</span>
      <span class="text-[#07172D] font-bold">{item.meta.id}</span>
    </nav>

    <!-- Header Card -->
    <div class="freewing-card p-6 sm:p-10 mb-10 border border-slate-200">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase px-3 py-1 rounded-full bg-blue-50 text-[#155EEF] border border-blue-200">
            {item.meta.type}
          </span>
          <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
            v{item.meta.version}
          </span>
          <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            {item.meta.status}
          </span>
        </div>
        <div class="text-xs text-slate-500 font-mono">
          更新日期: <time datetime={item.meta.updated}>{item.meta.updated}</time>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#07172D] tracking-tight mb-4">
        {item.meta.title}
      </h1>
      <p class="text-base text-slate-600 leading-relaxed mb-6">
        {item.meta.summary}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-6 border-t border-slate-100">
        {item.meta.repositoryUrl && (
          <a
            href={item.meta.repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl border border-slate-300 hover:border-slate-400 bg-white hover:bg-slate-50 text-[#07172D] text-sm font-semibold transition-all shadow-xs flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub Repo
          </a>
        )}
        {item.meta.downloadUrl && (
          <a
            href={item.meta.downloadUrl}
            class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#155EEF] to-[#27A8FF] hover:from-[#0D47C2] hover:to-[#155EEF] text-white text-sm font-semibold transition-all shadow-sm shadow-blue-500/20 flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            下載模組
          </a>
        )}
      </div>

      <!-- Metadata Attributes -->
      <div class="mt-6 pt-5 border-t border-slate-100 flex flex-wrap items-center gap-4 text-xs text-slate-500">
        <div>
          <span class="font-medium text-slate-400">分類:</span>
          <span class="text-[#07172D] font-semibold ml-1">{item.meta.category}</span>
        </div>
        <div>
          <span class="font-medium text-slate-400">工具:</span>
          {item.meta.tools.map(t => (
            <span class="ml-1.5 px-2 py-0.5 rounded bg-blue-50 text-[#155EEF] font-mono">{t}</span>
          ))}
        </div>
        <div>
          <span class="font-medium text-slate-400">標籤:</span>
          {item.meta.tags.map(tag => (
            <span class="ml-1.5 px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">#{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Article Content -->
    <article class="freewing-card p-6 sm:p-12 mb-10 prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-[#07172D] prose-a:text-[#155EEF] prose-pre:bg-slate-900 prose-pre:text-slate-100">
      <div set:html={htmlContent} />
    </article>

    <!-- Cross Relations -->
    {(item.meta.relatedProjects?.length || item.meta.relatedPresentations?.length) && (
      <div class="freewing-card p-6 sm:p-8 bg-slate-50/70 border border-slate-200">
        <h3 class="text-base font-bold text-[#07172D] mb-4">相關連資源</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {item.meta.relatedProjects?.map(projId => {
            const rel = getItemById(projId, false);
            return rel ? (
              <a href={getContentRoute('project', projId)} class="p-4 rounded-xl bg-white hover:border-blue-300 border border-slate-200 text-sm block transition-all shadow-2xs">
                <span class="text-xs text-[#155EEF] font-mono uppercase block font-semibold">關聯專案 &bull; CREATE</span>
                <span class="text-[#07172D] font-bold mt-0.5 block">{rel.meta.title}</span>
              </a>
            ) : null;
          })}
          {item.meta.relatedPresentations?.map(presId => {
            const rel = getItemById(presId, false);
            return rel ? (
              <a href={getContentRoute('presentation', presId)} class="p-4 rounded-xl bg-white hover:border-amber-300 border border-slate-200 text-sm block transition-all shadow-2xs">
                <span class="text-xs text-amber-700 font-mono uppercase block font-semibold">關聯簡報 &bull; SHARE</span>
                <span class="text-[#07172D] font-bold mt-0.5 block">{rel.meta.title}</span>
              </a>
            ) : null;
          })}
        </div>
      </div>
    )}
  </div>
</MainLayout>
